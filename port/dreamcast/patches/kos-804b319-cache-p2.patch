diff --git a/kernel/arch/dreamcast/include/arch/cache.h b/kernel/arch/dreamcast/include/arch/cache.h
--- a/kernel/arch/dreamcast/include/arch/cache.h
+++ b/kernel/arch/dreamcast/include/arch/cache.h
@@ -161,12 +161,23 @@
         arch_dcache_inval_line((void *)start);
 }
 
+#if defined(KOS_CACHE_P2) && KOS_CACHE_P2
+#define KOS_DCACHE_WBACK_P2_ACTIVE 1
+/* SH7750/SH7750S: memory-mapped cache access must execute in P2.
+   External call also orders ordinary memory stores around the writeback. */
+void arch_dcache_wback_all_p2(void);
+#endif
+
 static inline void arch_dcache_wback_all(void) {
+#if defined(KOS_CACHE_P2) && KOS_CACHE_P2
+    arch_dcache_wback_all_p2();
+#else
     unsigned int i;
     volatile uint32_t *dca = (volatile uint32_t *)0xf4000008;
 
     for (i = 0; i < 512; i++, dca += 8)
         *dca &= ~BIT(1); /* Zero out U bit */
+#endif
 }
 
 static inline void arch_dcache_wback_range(uintptr_t start, size_t count) {
diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -13,6 +13,19 @@
 # I expect everyone to keep their code warning free. Don't make me add -Werror
 # here too. ;-)
 KOS_CFLAGS += -Wextra -Wno-deprecated
+
+# Optional SH7750 whole-cache writeback repair. Rebuild KOS and consumers in
+# a separate tree with KOS_CACHE_P2=1; the default emits the original objects.
+KOS_CACHE_P2 ?= 0
+ifneq ($(KOS_CACHE_P2),0)
+ifneq ($(KOS_CACHE_P2),1)
+$(error KOS_CACHE_P2 must be 0 or 1)
+endif
+endif
+ifeq ($(KOS_CACHE_P2),1)
+export KOS_CACHE_P2
+override KOS_CFLAGS += -DKOS_CACHE_P2=1
+endif
 
 # Add stuff to SUBDIRS to auto-compile it with the big tree.
 SUBDIRS = utils kernel addons # examples
