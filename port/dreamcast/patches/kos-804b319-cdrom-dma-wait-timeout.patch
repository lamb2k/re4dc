+/* RE4DC DISC_DMA_WAIT_TIMEOUT: a DMA wait gave up. Stop the G1 GD-DMA in hardware first (SB_GDEN 0xA05F7414 = 0 aborts
+   a transfer in progress; SB_GDST 0xA05F7418 reads 1 while one runs), so a loader that completes late cannot write
+   into a buffer the caller has moved on from. Then close KOS's DMA state with interrupts off: both completion paths
+   (g1_dma_irq_hnd, cdrom_vblank) act only while dma_in_progress, so a late completion is passed on, not counted.
+   Abort the BIOS command (1 s bound; drive reset + init + settle on timeout, as cdrom_abort_cmd), take back any
+   completion already signalled, and re-enable the engine for the next command (it starts only on SB_GDST). The
+   caller holds _g1_ata_sem and releases it. */
+static void re4dc_dma_abort(void) {
+    int old = irq_disable();
+    if(*(volatile uint32_t *)0xa05f7418 & 1)
+        ++re4dc_cdrom_wait_hw_busy;
+    *(volatile uint32_t *)0xa05f7414 = 0;
+    dma_in_progress = false;
+    dma_blocking = false;
+    dma_auto_unlock = false;
+    irq_restore(old);
+    if(cmd_hnd > 0) {
+        syscall_gdrom_abort_command(cmd_hnd);
+        if(cdrom_poll(&cmd_hnd, 1000, cdrom_check_abort_done) == ERR_TIMEOUT) {
+            ++re4dc_cdrom_wait_abort_reset;
+            syscall_gdrom_reset();
+            syscall_gdrom_init();
+            thd_sleep(100);
+        }
+    }
+    cmd_hnd = 0;
+    stream_enabled = false;
+    stream_cb = NULL;
+    old = irq_disable();
+    while(sem_trywait(&dma_done) == 0) {}
+    *(volatile uint32_t *)0xa05f7414 = 1;
+    irq_restore(old);
+}
