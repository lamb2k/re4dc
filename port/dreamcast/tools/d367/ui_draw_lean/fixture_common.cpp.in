static std::vector<u32> observations;
static std::ofstream output;
static std::ofstream scalar_ta_output;
static u32 bits(float f){u32 v;std::memcpy(&v,&f,4);return v;}
static void words(const void* ptr,unsigned bytes){
    assert((bytes&3)==0);const auto* p=static_cast<const unsigned char*>(ptr);
    for(unsigned n=0;n<bytes;n+=4){u32 v;std::memcpy(&v,p+n,4);observations.push_back(v);}
}
static void event(std::initializer_list<u32> values){observations.insert(observations.end(),values);}
static u32 ptr32(const void* p){auto n=reinterpret_cast<std::uintptr_t>(p);assert(n<=0xffffffffULL);return u32(n);}
// Serialize every field in the target 104-byte quad, without host pointer padding.
static std::array<u32,26> quad_words(const Re4dcUiQuad& q){
    std::array<u32,26> w{};w[0]=ptr32(q.image.pixels);w[1]=ptr32(q.image.palette);
    w[2]=q.image.width;w[3]=q.image.height;w[4]=q.image.format;w[5]=q.image.palette_format;w[6]=q.image.palette_bytes;
    for(unsigned n=0;n<8;++n){w[7+n]=bits(q.xy[n]);w[15+n]=bits(q.uv[n]);}
    w[23]=q.color;w[24]=q.blend;w[25]=q.masked;return w;
}
static_assert(sizeof(std::array<u32,26>)==104);
static void note_quad(unsigned kind,const Re4dcUiQuad& q){event({kind});auto w=quad_words(q);words(w.data(),sizeof w);}

static unsigned total_cases,bridge_cases,native_cases,camera_cases,glyph_cases;
static unsigned ta_packets,ta_words,ta_vertices,defined_headers,opaque_tail_headers,full_header_hits;
static unsigned resolve_calls,compile_calls,projection_calls,empty_load_calls,empty_current_calls,diagnostic_calls;
static unsigned bridge_submissions,mask_calls,prompt_calls,letterbox_calls,option_calls;
static unsigned long long diagnostic_hash=1469598103934665603ULL;
extern "C" void re4dc_log(const char* fmt,...){
    char buf[512];va_list ap;va_start(ap,fmt);int n=std::vsnprintf(buf,sizeof buf,fmt,ap);va_end(ap);
    assert(n>=0 && unsigned(n)<sizeof buf);++diagnostic_calls;
    for(int i=0;i<n;++i){diagnostic_hash^=u8(buf[i]);diagnostic_hash*=1099511628211ULL;}
}
