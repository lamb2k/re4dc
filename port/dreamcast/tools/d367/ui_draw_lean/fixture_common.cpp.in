#define PVR_RAM_SIZE (8U*1024U*1024U)
// KOS MOVCA may leave packed-color words4..7 unspecified. Give them an explicit
// marker in the host edge; capture masks only those words, including glyph fills.
static constexpr u32 kUnspecifiedTail=0xd4d4d4d4U;
static void dcache_alloc_line_with_value(void* dst,u32 cmd){
    auto* p=static_cast<u32*>(dst);p[0]=cmd;for(unsigned i=4;i<8;++i)p[i]=kUnspecifiedTail;
    ++compile_calls;
}
