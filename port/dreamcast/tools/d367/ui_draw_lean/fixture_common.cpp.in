static constexpr unsigned kQuadCount=256,kFixtureEntries=12;
static Entry entries[kFixtureEntries];
static Re4dcUiQuad quads[kQuadCount];
static Entry* handles[kQuadCount];
static unsigned char frame_storage[sizeof quads];
static unsigned frame=1,nquad,quads_flushed,deferred_top=sizeof frame_storage,drawn,culled,unsupported,dropped,missing,frame_queue_drops;
static bool frame_ready=true,stream_aborted,world_autosort=true,ui_order=true,black,movie_override;
static unsigned overlay_layer;
static int re4dc_vi_black(){return black;}
static void stream_select(pvr_list_t list){event({0x10000001U,unsigned(list)});}
static void capture_ta(const void* data,unsigned bytes){
    assert((bytes%32)==0);++ta_packets;ta_words+=bytes/4;event({0x10000002U,bytes});
    // Preserve all fixture words as a separate stream, including the explicit
    // MOVCA marker. This stream is a scalar-fixture result, not a claim that
    // hardware defines those four cold-header tail words.
    scalar_ta_output.write(reinterpret_cast<const char*>(&bytes),4);
    scalar_ta_output.write(static_cast<const char*>(data),bytes);assert(scalar_ta_output.good());
    const auto* p=static_cast<const u8*>(data);
    for(unsigned offset=0;offset<bytes;offset+=32){
        u32 w[8];std::memcpy(w,p+offset,32);
        if((w[0]&0xe0000000U)==0x80000000U){
            ++defined_headers;
            bool undefined=true;for(unsigned n=4;n<8;++n)undefined&=w[n]==kUnspecifiedTail;
            if(undefined){++opaque_tail_headers;for(unsigned n=4;n<8;++n)w[n]=0;}
            else ++full_header_hits;
        }else{assert(w[0]==PVR_CMD_VERTEX||w[0]==PVR_CMD_VERTEX_EOL);++ta_vertices;}
        words(w,32);
    }
}
static void stream_send(const void* p,unsigned n){capture_ta(p,n);}
namespace re4dc::render {
@BEGIN_PACKET@
static void submit_pvr(const void* p,unsigned n){capture_ta(p,n);}
}
@OVERLAY_DEPTH@

static Entry* resolve(const Re4dcUiImage& image,const void*,bool){
    ++resolve_calls;event({0x10000003U,ptr32(image.pixels),ptr32(image.palette),image.width,image.height,image.format,image.palette_format,image.palette_bytes});
    const unsigned n=(ptr32(image.pixels)>>12)%kFixtureEntries;
    if(!image.pixels||!entries[n].valid)return nullptr;
    entries[n].frame=frame;return &entries[n];
}
static Entry* load(const Re4dcUiImage& image){return resolve(image,nullptr,true);}
static void fixture_native_enqueue_note(const Re4dcUiQuad* q){++bridge_submissions;note_quad(0x10000004U,*q);}
