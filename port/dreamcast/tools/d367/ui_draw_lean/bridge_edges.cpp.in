extern const std::uintptr_t ui_fixture_bridge_layout[]={
    1,sizeof(IdUnit),sizeof(TexWk),sizeof(TEXHeader),sizeof(CLUTHeader),sizeof(TEXPalette),sizeof(TEXDescriptor),sizeof(Re4dcUiQuad),
    reinterpret_cast<std::uintptr_t>(&ui_fixture_unit),reinterpret_cast<std::uintptr_t>(ui_fixture_wk),
    reinterpret_cast<std::uintptr_t>(ui_fixture_tpl),reinterpret_cast<std::uintptr_t>(ui_fixture_desc),
    reinterpret_cast<std::uintptr_t>(ui_fixture_tex),reinterpret_cast<std::uintptr_t>(ui_fixture_clut),
    offsetof(TexWk,pTpl),offsetof(IdUnit,mat),offsetof(IdUnit,vtx),offsetof(IdUnit,col),offsetof(IdUnit,u0),
    reinterpret_cast<std::uintptr_t>(&ui_fixture_mask_result)
};
}
TexWk* IdGetTexWk(u8 id,int) {return &ui_fixture_wk[id==0x12];}
