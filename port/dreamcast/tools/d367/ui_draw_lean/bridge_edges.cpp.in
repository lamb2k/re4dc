void re4dc_zam_MTXConcat(const float a[3][4],const float b[3][4],float d[3][4]) {
    // Synthetic source screen matrix is identity. The unchanged SH4ZAM edge
    // is represented by an exact copy; original matrix arithmetic is excluded.
    __builtin_memcpy(d,b,48);
}
