// Record RAM-prefetch requests separately from TA words. Address evaluation
// and live-range assertions execute; host cache behavior is not SH-4 evidence.
// The old PREF_WALK edge is also recorded; SQ dispatch uses sq_flush instead.
struct PrefRegion {std::uintptr_t first,last;unsigned kind;};
static std::vector<PrefRegion> prefetch_regions;
static std::vector<std::uint32_t> prefetch_words;
static unsigned prefetch_mask=4;
static void prefetch_region(const void* p,std::size_t bytes,unsigned kind){
    const auto first=reinterpret_cast<std::uintptr_t>(p);
    prefetch_regions.push_back({first,first+bytes,kind});
}
static void fixture_prefetch(const void* p){
    const auto address=reinterpret_cast<std::uintptr_t>(p);
    for(const auto& region:prefetch_regions)if(address>=region.first&&address<region.last){
        prefetch_words.push_back(region.kind);prefetch_words.push_back(unsigned(address-region.first));return;
    }
    std::fprintf(stderr,"prefetch outside registered live data: %p\n",p);std::abort();
}
#define __builtin_prefetch(p,...) fixture_prefetch(p)
#define RE4DC_C20_PREF_ON() ((prefetch_mask&4U)!=0)
#define RE4DC_C20_PREF(p) fixture_prefetch(p)

