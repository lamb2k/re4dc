void re4dc_log(const char*,...){}
void re4dc_static_free(void*){}
void identity(float* a){std::memset(a,0,48);a[0]=a[5]=a[10]=1;}
// Arithmetic boundary mocks are intentionally limited to rigid translations.
void concat(const float* a,const float* b,float* out){
    float q[12];
    for(unsigned r=0;r<3;++r){
        for(unsigned c=0;c<3;++c)q[4*r+c]=a[4*r]*b[c]+a[4*r+1]*b[4+c]+a[4*r+2]*b[8+c];
        q[4*r+3]=a[4*r]*b[3]+a[4*r+1]*b[7]+a[4*r+2]*b[11]+a[4*r+3];
    }
    std::memcpy(out,q,48);
}
bool inverse(const float* a,float* b){identity(b);b[3]=-a[3];b[7]=-a[7];b[11]=-a[11];return inverse_ok;}
namespace gate { unsigned room=0x10d;constexpr unsigned kMax=32;unsigned owned[1]{},cur[1]{},want[1]{}; }
namespace area {bool cur=false,hidden=false;bool hide(unsigned){return hidden;} }
struct Placement {float affine[12];unsigned placement=0;};
struct World {void* storage;void* parts;unsigned room,nplacements;Placement placements[2];float view[12];} ps2w;
@DYN@
@INTACT@
namespace re4dc::vp {constexpr unsigned kCacheSlots=256;}
