  "candidate_patch": "diff --git a/port/dreamcast/game/game30.mk b/port/dreamcast/game/game30.mk\nindex de792635..e89f5ce9 100644\n--- a/port/dreamcast/game/game30.mk\n+++ b/port/dreamcast/game/game30.mk\n@@ -2377,6 +2377,17 @@ $(error GAME_HF_REG and GAME_HF_ASM both replace the hermite entry)\n endif\n $(OBJDIR)/src/game/motion.o: GAME_CPPFLAGS += -DRE4DC_HF_REG=$(GAME_HF_REG)\n endif\n+# ANIM_SAMPLE_LEAN=1 (exact; default 0): GAME_HF_REG's exact-key and clamped-end arms read only\n+#              the returned value. Its invalid-history/search-exhaustion fallback still recomputes\n+#              the complete original call, including the cross-axis stale pair. Other samplers and\n+#              all interpolation arithmetic are unchanged; this does not enable GAME_HF_REG itself.\n+ANIM_SAMPLE_LEAN ?= 0\n+ifneq ($(ANIM_SAMPLE_LEAN),0)\n+ifneq ($(ANIM_SAMPLE_LEAN),1)\n+$(error ANIM_SAMPLE_LEAN must be 0 or 1)\n+endif\n+$(OBJDIR)/src/game/motion.o: GAME_CPPFLAGS += -DRE4DC_ANIM_SAMPLE_LEAN=1\n+endif\n # GAME_SND_WALL_ALT=1 (audio only; report candidate 12): sndSurroundCalc tests a tracked SE's wall occlusion (a line\n #                     query to the player's head) on every other frame and reuses the slot's last verdict in\n #                     between (snd.cpp). Only an occluded SE's muffled volume can lag one frame; the logic trace\ndiff --git a/src/game/motion.cpp b/src/game/motion.cpp\nindex 7ce3297d..7a2d6f97 100644\n--- a/src/game/motion.cpp\n+++ b/src/game/motion.cpp\n@@ -20,6 +20,12 @@\n #include \"player.h\"\n #include \"eprintf.h\"\n \n+// ANIM_SAMPLE_LEAN (Dreamcast; default 0): hfReg's completed axes need only the selected value.\n+// A failed search restarts the whole call in hermiteFast, which owns the cross-axis stale pair.\n+#ifndef RE4DC_ANIM_SAMPLE_LEAN\n+#define RE4DC_ANIM_SAMPLE_LEAN 0\n+#endif\n+\n extern const Vec vecZero;\n extern \"C\" void* memset(void* dst, int c, unsigned int n);\n \n@@ -1687,9 +1693,11 @@ __attribute__((noinline)) int hfReg(HermitePrm* prm, Vec* out, u16* hist)\n                 }\n             } else {\n                 v0 = L::v(data, n - 1);\n+#if !defined(RE4DC_GAME) || defined(__PPC__) || !RE4DC_ANIM_SAMPLE_LEAN\n                 v1 = L::v(data, 0);\n                 t0 = L::t0(data, n - 1);\n                 t1 = L::t1(data, 0);\n+#endif\n                 cnt = 0;\n                 found = 1;\n                 r = v0;\n@@ -1706,9 +1714,11 @@ __attribute__((noinline)) int hfReg(HermitePrm* prm, Vec* out, u16* hist)\n                 f0 = (f32) *fp;\n                 if (f0 == frame) {\n                     v0 = L::v(data, idx);\n+#if !defined(RE4DC_GAME) || defined(__PPC__) || !RE4DC_ANIM_SAMPLE_LEAN\n                     v1 = L::v(data, 0);\n                     t0 = L::t0(data, idx);\n                     t1 = L::t1(data, 0);\n+#endif\n                     r = v0;\n                     if (!(flags & 8)) {\n                         *hp = idx;\n",
