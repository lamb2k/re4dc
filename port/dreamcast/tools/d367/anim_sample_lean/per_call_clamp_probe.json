  "candidate_patch": "diff --git a/port/dreamcast/game/game30.mk b/port/dreamcast/game/game30.mk\nindex de792635..45e7d4d1 100644\n--- a/port/dreamcast/game/game30.mk\n+++ b/port/dreamcast/game/game30.mk\n@@ -2377,6 +2377,17 @@ $(error GAME_HF_REG and GAME_HF_ASM both replace the hermite entry)\n endif\n $(OBJDIR)/src/game/motion.o: GAME_CPPFLAGS += -DRE4DC_HF_REG=$(GAME_HF_REG)\n endif\n+# ANIM_SAMPLE_LEAN=1 (exact; default 0): sample a non-wrapping clamped frame's three last values\n+#              without GAME_HF_REG's search/interpolation setup. Invalid histories keep the original\n+#              sampler, diagnostics and full-call fallback. Other samplers and interpolation arithmetic\n+#              are unchanged; this does not enable GAME_HF_REG itself.\n+ANIM_SAMPLE_LEAN ?= 0\n+ifneq ($(ANIM_SAMPLE_LEAN),0)\n+ifneq ($(ANIM_SAMPLE_LEAN),1)\n+$(error ANIM_SAMPLE_LEAN must be 0 or 1)\n+endif\n+$(OBJDIR)/src/game/motion.o: GAME_CPPFLAGS += -DRE4DC_ANIM_SAMPLE_LEAN=1\n+endif\n # GAME_SND_WALL_ALT=1 (audio only; report candidate 12): sndSurroundCalc tests a tracked SE's wall occlusion (a line\n #                     query to the player's head) on every other frame and reuses the slot's last verdict in\n #                     between (snd.cpp). Only an occluded SE's muffled volume can lag one frame; the logic trace\ndiff --git a/src/game/motion.cpp b/src/game/motion.cpp\nindex 7ce3297d..0198ea55 100644\n--- a/src/game/motion.cpp\n+++ b/src/game/motion.cpp\n@@ -20,6 +20,12 @@\n #include \"player.h\"\n #include \"eprintf.h\"\n \n+// ANIM_SAMPLE_LEAN (Dreamcast; default 0): sample all three clamped axes together.\n+// Other frames and exceptional histories keep the original register sampler and its fallback.\n+#ifndef RE4DC_ANIM_SAMPLE_LEAN\n+#define RE4DC_ANIM_SAMPLE_LEAN 0\n+#endif\n+\n extern const Vec vecZero;\n extern \"C\" void* memset(void* dst, int c, unsigned int n);\n \n@@ -1776,6 +1782,31 @@ bail:\n     hist[2] = hs2;\n     return hermiteFast(prm, out, hist);\n }\n+#if defined(RE4DC_GAME) && !defined(__PPC__) && RE4DC_ANIM_SAMPLE_LEAN\n+// Called only for a non-wrapping frame at/past maxFrame. All axes select their last value;\n+// no search, interpolation state or history transaction is needed. A failed validation delegates\n+// the whole call to hfReg so its error, diagnostics and stale-pair fallback remain authoritative.\n+template <int T>\n+__attribute__((noinline)) int hfClamped(HermitePrm* prm, Vec* out, u16* hist)\n+{\n+    typedef HfLayout<T> L;\n+    const u8* p = prm->key;\n+    const bool ignore_history = (prm->flags & 8) != 0;\n+    f32* o = (f32*) out;\n+    for (unsigned axis = 0; axis < 3; ++axis) {\n+        const unsigned n = *(const u16*) p;\n+        const u8* data = p + 2 + n * 2;\n+        p = data + n * L::S;\n+#if defined(RE4DC_HF_PF) && RE4DC_HF_PF\n+        if (axis < 2) __builtin_prefetch(p);\n+#endif\n+        const unsigned idx = ignore_history ? 0 : hist[axis];\n+        if (idx >= n) return hfReg<T>(prm, out, hist);\n+        o[axis] = L::v(data, n - 1);\n+    }\n+    return 0;\n+}\n+#endif\n int hermiteReg(HermitePrm* prm, Vec* out, u16* hist)\n {\n #if RE4DC_HF_REG == 2\n@@ -1795,12 +1826,24 @@ int hermiteReg(HermitePrm* prm, Vec* out, u16* hist)\n #define HFR_RET(x) return (x)\n #endif\n     if (!((u32) prm->key & 1)) {\n+#if defined(RE4DC_GAME) && !defined(__PPC__) && RE4DC_ANIM_SAMPLE_LEAN\n+        const bool clamped = prm->maxFrame <= prm->frame && (prm->flags & 6) != 4;\n+#endif\n         switch (prm->type) {\n         case 5:\n+#if defined(RE4DC_GAME) && !defined(__PPC__) && RE4DC_ANIM_SAMPLE_LEAN\n+            if (clamped) { HFR_RET(hfClamped<5>(prm, out, hist)); }\n+#endif\n             HFR_RET(hfReg<5>(prm, out, hist));\n         case 0:\n+#if defined(RE4DC_GAME) && !defined(__PPC__) && RE4DC_ANIM_SAMPLE_LEAN\n+            if (clamped) { HFR_RET(hfClamped<0>(prm, out, hist)); }\n+#endif\n             HFR_RET(hfReg<0>(prm, out, hist));\n         case 6:\n+#if defined(RE4DC_GAME) && !defined(__PPC__) && RE4DC_ANIM_SAMPLE_LEAN\n+            if (clamped) { HFR_RET(hfClamped<6>(prm, out, hist)); }\n+#endif\n             HFR_RET(hfReg<6>(prm, out, hist));\n         default:\n             break;\n",
