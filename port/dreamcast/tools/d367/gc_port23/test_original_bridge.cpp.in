 re4dc_gcasset_shape_reset(&info,prepared);model_base[412]=3;re4dc_gcasset_shape_source(&info,0,model_base+412,1);re4dc_gcasset_pose_publish(&info,1,0);assert(!re4dc_gcasset_original_model_select(&part).serial);model_base[412]=0;
 info.be_flag=0;
