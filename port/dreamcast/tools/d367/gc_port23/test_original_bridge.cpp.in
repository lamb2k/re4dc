 for(unsigned i=1;i<64;++i){assert(payload_capture_digest(gcasset_registry[i],owners+i,digest2));assert(payload_with_member(gcasset_registry[i],gcasset_registry[i].serial,re4dc_gcasset_original_color_member(&part,12)));}
