! Source-derived OFF steady emit loop, excludes per-strip setup/clip/call/hash/census.
mov.b @r9+,r2
add #32,r8
fmov dr6,@-r8
mov r2,r3
fmov dr4,@-r8
shld r12,r2
fmov dr2,@-r8
and r13,r2
fmov dr0,@-r8
add r11,r2
mov.l r5,@r8
shlr2 r3
pref @r8
shlr r3
fmov @r2+,dr8
and r14,r3
fmov @r2+,dr10
or r7,r3
fmov @r2+,dr12
add #32,r8
fmov @r2+,dr14
dt r10
bt odd_exit
mov.b @r9+,r4
add #32,r8
fmov dr14,@-r8
mov r4,r5
fmov dr12,@-r8
shld r12,r4
fmov dr10,@-r8
and r13,r4
fmov dr8,@-r8
add r11,r4
mov.l r3,@r8
shlr2 r5
pref @r8
shlr r5
fmov @r4+,dr0
and r14,r5
fmov @r4+,dr2
or r7,r5
fmov @r4+,dr4
add #32,r8
fmov @r4+,dr6
dt r10
bf loop
