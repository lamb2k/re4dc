unsigned room_generation=41,room_state_calls=0;bool room_live=true;
extern "C" int re4dc_room4_state(unsigned* g,unsigned* c,unsigned* b,unsigned* s,unsigned* r){
    ++room_state_calls;*g=room_generation;*c=*b=*s=*r=0;return room_live;
}
float viewport[6]={0,0,640,480,0,1};
void GXGetViewportv(float* out){std::memcpy(out,viewport,sizeof(viewport));}
const TEXDescriptor* TEXGet(const Tpl* tpl,unsigned i){assert(i==0);return tpl->descriptor;}
void PSMTXConcat(const Mtx a,const Mtx b,Mtx out){
    for(unsigned r=0;r<3;++r)for(unsigned c=0;c<4;++c){
        out[r][c]=c==3?a[r][3]:0;
        for(unsigned k=0;k<3;++k)out[r][c]+=a[r][k]*b[k][c];
    }
}
void PSMTXMultVec(const Mtx m,const Vec* p,Vec* out){
    out->x=m[0][0]*p->x+m[0][1]*p->y+m[0][2]*p->z+m[0][3];
    out->y=m[1][0]*p->x+m[1][1]*p->y+m[1][2]*p->z+m[1][3];
    out->z=m[2][0]*p->x+m[2][1]*p->y+m[2][2]*p->z+m[2][3];
}
struct GXColor{u8 r=255,g=255,b=255,a=255;};
bool EffIsSetFinalCol(){return false;}void EffGetFinalCol(GXColor*){assert(false);}
extern "C" int ESP_IsActive(cEsp* e){return bool(e->m_Be_flg&1);}
void Ps2fxAdditionsDraw(){} // The unrelated r118/r11c addition is outside this fixture.
