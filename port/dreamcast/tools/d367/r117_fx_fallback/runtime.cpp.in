struct Tpl{unsigned numDescriptors=1;TEXDescriptor* descriptor=nullptr;};
struct Animation{unsigned Cx=0,Cy=0,Width=96,Height=96,Frames=1;};
struct EspTexWk{unsigned Owner=1;Tpl* pTpl=nullptr;Animation* pAnm=nullptr;Mtx mtx{};};
struct EspSys{u8* pEspBuf=nullptr;unsigned nEsp=0;EspTexWk Esp_tex_tbl[256]{};}espsys;
EspSys* g_pEspSys=&espsys;
