    unsigned color=0xffffffff;unsigned char src=4,dst=1,screen=0,pad=0;};
Re4dcEffectSprite s_stage1_sprites[50]{};
struct Key{unsigned crc=0,fnv=0;bool operator==(const Key& b)const{return crc==b.crc&&fnv==b.fnv;}};
struct Entry{bool valid=false;Key key{};unsigned frame=0;};Entry entries[2]{};
struct DeferredLighting{};
struct DeferredPart{DeferredPart* next=nullptr;DeferredLighting* lighting=nullptr;unsigned changed[2]{};};
constexpr unsigned kSpriteNode=(sizeof(DeferredPart)+31)&~31U,kSpritePacket=96,kFxOctPacket=288;
DeferredLighting* const kSpriteTag=reinterpret_cast<DeferredLighting*>(1);
DeferredLighting* const kFxOctTag=reinterpret_cast<DeferredLighting*>(8);
struct Re4dcUiQuad{unsigned char bytes[104];};
alignas(32) unsigned char frame_storage[26*1024]{},spill_storage[24*1024]{};
unsigned deferred_top=sizeof(frame_storage),deferred_spill_capacity=0,deferred_spill_top=0;
unsigned char* deferred_spill=nullptr;
DeferredPart* deferred_first=nullptr;DeferredPart* deferred_last=nullptr;
unsigned deferred_count=0,nquad=0,frame_queue_peak=0;
bool frame_ready=true,stream_aborted=false,draining_parts=false,source_draws_finished=false;
unsigned frame=1,fx_frame=1,fx_count=0,fx_capped=0,fx_culled=0,fx_dropped=0,fx_missing=0,fx_queued=0,fx_direct=0,fx_peak=0;
unsigned fx_new_loads=0,load_opens=0,fx_evict_frame=~0U-8;
constexpr unsigned kFxNewLoads=4;bool fx_resident_only=false;
unsigned last_refusal=0,packet_calls=0,stream_calls=0,spill_calls=0;bool supply_spill=false;
void re4dc_log(const char* fmt,...){
    if(std::strstr(fmt,"PS2FXSTAGE1_BATCH")){
        va_list ap;va_start(ap,fmt);(void)va_arg(ap,unsigned);last_refusal=va_arg(ap,unsigned);va_end(ap);
    }
}
namespace re4dc{namespace render{bool is_finite(float x){return std::isfinite(x);}}}
bool same_image(const Re4dcUiImage&a,const Re4dcUiImage&b){return a.pixels==b.pixels;}
unsigned image_size(const Re4dcUiImage&i){return i.width*i.height;}
bool image_key(const Re4dcUiImage&i,Key&k){k={unsigned(reinterpret_cast<std::uintptr_t>(i.pixels)),0};return true;}
Entry* resolve(const Re4dcUiImage&i,void*,bool){
    Key k{};image_key(i,k);for(auto&e:entries)if(e.valid&&e.key==k){e.frame=frame;return &e;}return nullptr;
}
float (*re4dc_fog_gate_far)()=nullptr;
void fx_packet(const Re4dcEffectSprite&,Entry*,unsigned char*out){++packet_calls;std::memset(out,0,kSpritePacket);}
int fx_trim(const Re4dcEffectSprite&,Entry*,Re4dcEffectSprite&,float*,float*){return 0;}
void fx_trim_oct_packet(const Re4dcEffectSprite&,Entry*,float*,float*,unsigned char*out){std::memset(out,0,kFxOctPacket);}
void stream_select(int){}void stream_send(const void*,unsigned){++stream_calls;}void fx_send(unsigned char*,bool){++stream_calls;}
void* re4dc_model_deferred_storage(unsigned*bytes){
    ++spill_calls;*bytes=supply_spill?sizeof(spill_storage):0;return supply_spill?spill_storage:nullptr;
}
#if RE4DC_FX_R200_ENTRY_CAP
re4dc::fx_r200::Tail fx_r200_tail;
bool fx_r200_tail_select(unsigned required,unsigned char*& storage,unsigned*& top){
    re4dc::fx_r200::Context c;c.room=room_id;
    // r117 never reaches the r200-only tail, regardless of other fields.
    const auto result=fx_r200_tail.select(c,required,storage,top);
    assert(result==re4dc::fx_r200::Result::OtherRoom);return false;
}
#endif
