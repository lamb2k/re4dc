@PUZZLE@

alignas(16) u8 pool[64*0x150]{},other_pool[64*0x150]{};
Parent parent;Model model;Animation animation;TEXHeader tex_header;TEXDescriptor descriptor;Tpl tpl;
cEsp* anchors[3]{};
static Re4dcEffectSprite sprite(unsigned image_id){
    Re4dcEffectSprite s{};s.image.pixels=reinterpret_cast<void*>(std::uintptr_t(image_id));
    for(unsigned i=0;i<4;++i){s.x[i]=(i==1||i==2)?110:100;s.y[i]=i<2?100:110;s.z[i]=0.001f;s.u[i]=i&1;s.v[i]=i>>1;}
    return s;
}
static void identity(Mtx m){std::memset(m,0,sizeof(Mtx));for(unsigned i=0;i<3;++i)m[i][i]=1;}
static void reset_frame(unsigned colors=1){
    static_assert(sizeof(cPs2fxEsp0a)<=0x150);
    ++frame;pG=&globals;globals.Frame_cnt=frame;globals.Status_flg[0]=globals.Status_flg[1]=0;
    room_id=0x117;room_live=true;++room_generation;model={};parent={};identity(parent.mat);parent.mat[2][3]=-3000;
    identity(globals.Cam.v_mat);std::memset(globals.Cam.ProjMat,0,sizeof(Mtx44));
    globals.Cam.ProjMat[0][0]=globals.Cam.ProjMat[1][1]=1;
    globals.Cam.ProjMat[2][2]=-1.0f/19999.0f;globals.Cam.ProjMat[2][3]=-20000.0f/19999.0f;
    viewport[2]=640;viewport[3]=480;
    g_pEspSys=&espsys;espsys={};espsys.pEspBuf=pool;EspgenArray=nullptr;nEspgen=0;
    std::memset(pool,0,sizeof(pool));
    for(unsigned color=0;color<3;++color){
        anchors[color]=nullptr;if(!(colors&(1U<<color)))continue;
        for(unsigned rank=0;rank<(color==1?50U:1U);++rank){
            auto* e=new(pool+espsys.nEsp++*0x150)cPs2fxEsp0a{};
            e->info.Call_no=100+color;e->parent={&parent,0x1000};e->m_pMod={&model,0x2000};
            e->m_Col_start_r=color==0?50:0;e->m_Col_start_g=color==1?50:0;e->m_Col_start_b=color==2?50:0;
            e->m_Pos={kPuzzleX[color],kPuzzleY[color],-250.0f*rank};
            if(color!=1){e->m_Id=0x0a;e->m_Tool_flg=0x8400;e->m_Speed.z=-250;e->type=1;e->base_alpha=130;}
            if(!rank)anchors[color]=e;
        }
    }
    animation={};tex_header={reinterpret_cast<void*>(0x13),96,96,1};descriptor={&tex_header,nullptr};tpl={1,&descriptor};
    EspTexWk& tw=espsys.Esp_tex_tbl[0x13];tw={};tw.Owner=1;tw.pTpl=&tpl;tw.pAnm=&animation;identity(tw.mtx);
    fx_frame=frame;fx_count=0;deferred_top=sizeof(frame_storage);deferred_first=deferred_last=nullptr;deferred_count=0;
    deferred_spill=nullptr;deferred_spill_capacity=deferred_spill_top=0;supply_spill=false;
    frame_ready=true;stream_aborted=draining_parts=source_draws_finished=false;
    last_refusal=packet_calls=stream_calls=spill_calls=0;re4dc_fx_essential=1;re4dc_fx_level=0;re4dc_ps2fx=PS2FX_STREAK;
    entries[0]={false,{0x13,0},0};entries[1]={true,{0xff,0},0};
}
static cEsp copy(unsigned color){
    assert(anchors[color]);cEsp e=*anchors[color];e.m_Id=0;e.m_Life_max=color==1?0:1;e.m_Speed={};return e;
}
static void replace(){
    u8 before[sizeof(pool)];std::memcpy(before,pool,sizeof(pool));
    Ps2fxStage1Prepare();re4dc_ps2_fx_stage1_render(1,0);
    assert(std::memcmp(before,pool,sizeof(pool))==0); // No source state/lifetime writes.
}
static bool fallback(const cEsp& e){
#if defined(RE4DC_R117_FX_FALLBACK)
    return Ps2fxPuzzleFallback(&e);
#else
    (void)e;return false;
#endif
}
static void expect_eligible(cEsp& e,bool permitted){
    assert(!Ps2fxPuzzleSuppress(&e));assert(fallback(e)==permitted);
    Re4dcEffectSprite s=sprite(0xff);
    assert(FxTrimSprite(&e,&s,100)==(permitted?0:5));
#if defined(RE4DC_ESP_ESSENTIAL_EARLY)
    // The late call has initialized/reset both production bucket stamps.
    assert(FxEssentialSetupCut(&e,0)==!permitted);
#endif
}
static int draw_source(cEsp& e){
    // Controlled transform/texture boundary between actual production filters.
    if(Ps2fxPuzzleSuppress(&e))return 0;
#if defined(RE4DC_ESP_ESSENTIAL_EARLY)
    if(FxEssentialSetupCut(&e,0))return 0;
#endif
    Re4dcEffectSprite s=sprite(0xff);
    return FxTrimSprite(&e,&s,100)==0?re4dc_effect_sprite(&s):0;
}
static void missing_texture(){
    reset_frame();cEsp e=copy(0);replace();
    assert(last_refusal==31 && fx_count==0 && deferred_count==0 && packet_calls==0 && stream_calls==0);
    expect_eligible(e,RE4DC_R117_FX_QUALIFIED_FALLBACK);
    assert(draw_source(e)==RE4DC_R117_FX_QUALIFIED_FALLBACK);
    assert(packet_calls==RE4DC_R117_FX_QUALIFIED_FALLBACK);
    // A repeated consumed render call cannot revoke the failed-colour ticket.
    re4dc_ps2_fx_stage1_render(1,0);assert(fallback(e)==bool(RE4DC_R117_FX_QUALIFIED_FALLBACK));
    reset_frame(2);e=copy(1);replace();
    assert(last_refusal==31 && s_puzzle[1].evidence.complete() && !s_puzzle_active);
    expect_eligible(e,RE4DC_R117_FX_QUALIFIED_FALLBACK);
    assert(draw_source(e)==RE4DC_R117_FX_QUALIFIED_FALLBACK);
}
static void capacities(){
    reset_frame();entries[0].valid=true;fx_count=63;cEsp e=copy(0);replace();
    assert(last_refusal==21 && fx_count==63 && deferred_count==0 && packet_calls==0);
    expect_eligible(e,RE4DC_R117_FX_QUALIFIED_FALLBACK);
    assert(draw_source(e)==RE4DC_R117_FX_QUALIFIED_FALLBACK);
    if(RE4DC_R117_FX_QUALIFIED_FALLBACK)assert(fx_count==64 && !draw_source(e));
    reset_frame();entries[0].valid=true;e=copy(0);deferred_top=16384+kSpriteNode+kSpritePacket;replace();
    assert(last_refusal==22 && deferred_count==0 && packet_calls==0 && spill_calls==0);
    expect_eligible(e,RE4DC_R117_FX_QUALIFIED_FALLBACK);
    assert(draw_source(e)==RE4DC_R117_FX_QUALIFIED_FALLBACK);
    reset_frame();entries[0].valid=true;e=copy(0);deferred_top=16384;supply_spill=true;replace();
    assert(last_refusal==22 && spill_calls==0); // Batch never allocates the release's lazy spill.
    assert(draw_source(e)==RE4DC_R117_FX_QUALIFIED_FALLBACK);
    if(RE4DC_R117_FX_QUALIFIED_FALLBACK)assert(spill_calls==1 && deferred_spill==spill_storage);
    reset_frame();entries[0].valid=true;e=copy(0);fx_count=64;replace();
    expect_eligible(e,RE4DC_R117_FX_QUALIFIED_FALLBACK);assert(!draw_source(e));
    reset_frame();e=copy(0);entries[1].valid=false;replace();
    expect_eligible(e,RE4DC_R117_FX_QUALIFIED_FALLBACK);assert(!draw_source(e));
    reset_frame();entries[0].valid=true;e=copy(0);deferred_top=16384;replace();
    expect_eligible(e,RE4DC_R117_FX_QUALIFIED_FALLBACK);assert(!draw_source(e));
}
static void success_and_mixed(){
    reset_frame();entries[0].valid=true;cEsp e=copy(0);replace();
    assert(s_puzzle_active==1 && fx_count>0 && !last_refusal && Ps2fxPuzzleSuppress(&e) && !fallback(e));
    const unsigned count=fx_count,packets=packet_calls;assert(!draw_source(e));
    assert(fx_count==count && packet_calls==packets);
    re4dc_ps2_fx_stage1_render(1,0);assert(Ps2fxPuzzleSuppress(&e));
    reset_frame(7);entries[0].valid=true;replace();
    ps2fx::TrailPoint points[50];const unsigned n=ps2fx::puzzle_trail(points);
    assert(n*2<=64 && n*3>64 && s_puzzle_active==3 && last_refusal==21);
    assert(fx_count==n*2 && packet_calls==n*2 && deferred_count==n*2); // Third rejection atomic.
    for(unsigned c=0;c<3;++c){e=copy(c);
        if(c<2){assert(Ps2fxPuzzleSuppress(&e) && !fallback(e) && !draw_source(e));}
        else{expect_eligible(e,RE4DC_R117_FX_QUALIFIED_FALLBACK);assert(draw_source(e)==RE4DC_R117_FX_QUALIFIED_FALLBACK);}
    }
    // Same-frame retry after a new Prepare replaces the failed ticket completely.
    reset_frame();e=copy(0);replace();entries[0].valid=true;replace();
    assert(Ps2fxPuzzleSuppress(&e) && !fallback(e) && !draw_source(e));
    reset_frame();e=copy(0);model.be_flag=0;replace();
    assert(!last_refusal && !fx_count && Ps2fxPuzzleSuppress(&e) && !fallback(e));
    reset_frame();e=copy(0);parent.mat[2][3]=100000;replace();
    assert(!last_refusal && !fx_count && Ps2fxPuzzleSuppress(&e) && !fallback(e));
}
static void qualification(){
    reset_frame();cEsp original=copy(0);replace();
    for(unsigned change=0;change<14;++change){cEsp e=original;
        switch(change){
        case 0:++e.info.Call_no;break;case 1:++e.info.Core_pEm;break;case 2:++e.info.Core_flg;break;
        case 3:++e.parent.id;break;case 4:++e.m_pMod.id;break;case 5:++e.m_Guid_pMod;break;
        case 6:e.m_Life_max=0;break;case 7:e.m_Tool_flg=0x8000;break;case 8:e.m_Size_plus=1;break;
        case 9:e.m_Speed.z=1;break;case 10:e.m_Parts_no=1;break;case 11:e.m_Id=0x0a;break;
        case 12:e.m_Col_start_r=0;e.m_Col_start_b=50;break;case 13:e.info.owner=0xd0;break;
        }
        expect_eligible(e,false);
    }
    ++model.serial;expect_eligible(original,false);
    // No permission from missing/incomplete/duplicate qualification metadata.
    reset_frame(2);cEsp e=copy(1);--espsys.nEsp;replace();assert(!last_refusal);expect_eligible(e,false);
    reset_frame(2);e=copy(1);reinterpret_cast<cEsp*>(pool+0x150)->m_Pos.z=0;replace();assert(!last_refusal);expect_eligible(e,false);
    reset_frame();e=copy(0);animation.Width=95;replace();assert(!last_refusal);expect_eligible(e,false);
    reset_frame();e=copy(0);viewport[2]=0;replace();assert(!last_refusal);expect_eligible(e,false);
    reset_frame();e=copy(0);model.be_flag=0;frame_ready=false;replace();assert(last_refusal==1);expect_eligible(e,false);
}
static void lifetime_and_toggles(){
    reset_frame();cEsp e=copy(0);replace();++globals.Frame_cnt;expect_eligible(e,false);
    reset_frame();e=copy(0);replace();espsys.pEspBuf=other_pool;expect_eligible(e,false);
    espsys.pEspBuf=pool;Ps2fxStage1Prepare();expect_eligible(e,false);
    // Same pool address is reused with a different source identity in the same frame.
    ++anchors[0]->info.Call_no;cEsp rebound=copy(0);re4dc_ps2_fx_stage1_render(1,0);
    expect_eligible(e,false);expect_eligible(rebound,RE4DC_R117_FX_QUALIFIED_FALLBACK);
    reset_frame();e=copy(0);replace();room_live=false;expect_eligible(e,false);
    reset_frame();e=copy(0);replace();++room_generation;expect_eligible(e,false);
    replace();expect_eligible(e,RE4DC_R117_FX_QUALIFIED_FALLBACK);
    reset_frame();e=copy(0);replace();room_id=0x118;expect_eligible(e,false);
    reset_frame();e=copy(0);replace();re4dc_ps2fx=0;expect_eligible(e,false);
    Ps2fxStage1Prepare();re4dc_ps2fx=PS2FX_STREAK;expect_eligible(e,false);
    reset_frame();e=copy(0);replace();re4dc_fx_essential=0;assert(draw_source(e)==1);
    re4dc_fx_essential=1;expect_eligible(e,RE4DC_R117_FX_QUALIFIED_FALLBACK);
    // A skipped/stale pending frame grants neither suppression nor fallback.
    reset_frame();e=copy(0);Ps2fxStage1Prepare();re4dc_ps2_fx_stage1_render(1,1);expect_eligible(e,false);
    reset_frame();e=copy(0);Ps2fxStage1Prepare();++room_generation;re4dc_ps2_fx_stage1_render(1,0);expect_eligible(e,false);
    reset_frame();e=copy(0);Ps2fxStage1Prepare();espsys.pEspBuf=other_pool;re4dc_ps2_fx_stage1_render(1,0);expect_eligible(e,false);
}
int main(){
    missing_texture();capacities();success_and_mixed();qualification();lifetime_and_toggles();
    std::printf("{\"status\":\"PASS\",\"knob\":%u,\"early\":%u,\"r200\":%u,\"frames\":%u}\n",
        unsigned(RE4DC_R117_FX_QUALIFIED_FALLBACK),unsigned(RE4DC_ESP_SETUP_LEAN),unsigned(RE4DC_FX_R200_ENTRY_CAP),frame);
}
