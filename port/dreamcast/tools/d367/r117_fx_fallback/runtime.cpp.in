using Mtx=float[3][4];using Mtx44=float[4][4];
template<class T> struct TargetPtr {
    T* p=nullptr;unsigned id=0;
    explicit operator bool()const{return p!=nullptr;}
    explicit operator unsigned()const{return id;}
    T* operator->()const{return p;}
    bool operator==(const TargetPtr& b)const{return id==b.id;}
};
struct Vec{float x=0,y=0,z=0;};
struct Model{unsigned serial=7,be_flag=2;};
struct Parent{Mtx mat{};};
struct cEsp {
    struct{unsigned owner=1,Core_kind=2,Call_no=1,Core_pEm=2,Core_flg=0;}info;
    unsigned m_Id=0,m_Tex_id=0xff,m_Parts_no=0,m_Release_time=0xff,m_Be_flg=1,m_Flg=0;
    Vec m_Ang{},m_Speed{},m_Pos{};
    float m_Size_base_x=470,m_Size_base_y=470,m_Size_plus=0,m_Size_mul=1;
    unsigned m_Col_start_a=130,m_Del_far=200,m_Del_near=50,m_Blend_type=1;
    unsigned m_Col_start_r=0,m_Col_start_g=50,m_Col_start_b=0;
    TargetPtr<Parent> parent{};TargetPtr<Model> m_pMod{};unsigned m_Guid_pMod=7;
    unsigned m_Tool_flg=0x8000,m_Life_max=0;
};
TargetPtr<Parent> pEffParentWorld{};
