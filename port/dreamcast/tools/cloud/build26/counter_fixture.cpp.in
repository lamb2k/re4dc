// The complete production core is included unchanged. These adapters only
// supply synthetic arguments and expose addresses for the target observer.
#include "@DC@/game/draw_fallback_audit.cpp"

extern "C" {
re4dc::dfa26::Snapshot fixture_output;
__attribute__((noinline)) void fixture_hit_one(unsigned) {
    re4dc::dfa26::hit(re4dc::dfa26::Reason(0));
}
__attribute__((noinline)) void fixture_hit_amount(unsigned amount) {
    re4dc::dfa26::hit(re4dc::dfa26::Reason(0), amount);
}
__attribute__((noinline)) void fixture_hit_last(unsigned) {
    re4dc::dfa26::hit(re4dc::dfa26::Reason(re4dc::dfa26::ReasonCount - 1));
}
__attribute__((noinline)) void fixture_begin(unsigned tick) {
    re4dc::dfa26::begin_tick(tick, 0x103);
}
__attribute__((noinline)) void fixture_end(unsigned) {
    re4dc::dfa26::end_tick();
}
__attribute__((noinline)) unsigned fixture_snapshot(unsigned present) {
    return re4dc::dfa26::snapshot(present ? &fixture_output : nullptr);
}
__attribute__((used)) extern const uintptr_t fixture_layout[] = {
    1, re4dc::dfa26::ReasonCount, sizeof(re4dc::dfa26::Snapshot),
    uintptr_t(&re4dc::dfa26::active), uintptr_t(re4dc::dfa26::live),
    uintptr_t(&re4dc::dfa26::overflow), uintptr_t(&re4dc::dfa26::sealed),
    uintptr_t(&re4dc::dfa26::tick), uintptr_t(&re4dc::dfa26::room),
    uintptr_t(&re4dc::dfa26::drawn), uintptr_t(&re4dc::dfa26::sequence),
    uintptr_t(&re4dc::dfa26::valid), uintptr_t(&re4dc::dfa26::paused),
    uintptr_t(&re4dc::dfa26::have_room), uintptr_t(&fixture_output),
};
}
