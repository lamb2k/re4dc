// Synthetic caller/callbacks linked to the separately compiled, unchanged
// production native_ui object. The adapter and selector are not copied here.
// Room/game-state callbacks are explicit stubs; their instruction/traffic
// costs are included, while the real owning subsystems are not exercised.
#include "@DC@/game/platform/include/fx_r200_entry_cap.h"
#include <cstddef>
using re4dc::fx_r200::Context;
using re4dc::fx_r200::Tail;
struct Arguments {
    unsigned required;
    unsigned char* storage;
    unsigned* cursor;
    unsigned admitted;
    unsigned limit;
};
extern "C" bool fixture_adapter(unsigned, unsigned char*&, unsigned*&)
    asm("@ADAPTER@");
extern "C" {
// room, live, generation, getter_calls, room_state_calls
unsigned fixture_room_parameters[5];
unsigned re4dc_room_id_now() {
    ++fixture_room_parameters[3];
    return fixture_room_parameters[0];
}
int re4dc_room4_state(unsigned* generation,unsigned* cells,unsigned* bytes,
                     unsigned* stale,unsigned* refused) {
    ++fixture_room_parameters[4];
    *generation=fixture_room_parameters[2];
    *cells=*bytes=*stale=*refused=0;
    return int(fixture_room_parameters[1]);
}
unsigned fixture_native_select(Arguments* a) {
    return fixture_adapter(a->required,a->storage,a->cursor);
}
unsigned fixture_native_admit(Arguments* a) {
    const bool accepted=fixture_adapter(a->required,a->storage,a->cursor);
    if(accepted){*a->cursor-=a->required;++a->admitted;}
    return accepted;
}
unsigned fixture_native_fill(Arguments* a) {
    for(unsigned i=0;i<a->limit;++i){
        if(!fixture_adapter(a->required,a->storage,a->cursor))return 0;
        *a->cursor-=a->required;++a->admitted;
    }
    return 1;
}
}
#define A(name) offsetof(Arguments,name)
#define S(name) offsetof(Tail,name)
extern "C" const unsigned fixture_native_layout[]={
    sizeof(Arguments),A(required),A(storage),A(cursor),A(admitted),A(limit),
    sizeof(Tail),S(data),S(owner),S(generation),S(top),S(poisoned)
};
