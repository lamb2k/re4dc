    reset();const auto*saved=work.prim;unsigned room=123;
    pG->vtx_buf_no=UINT_MAX;CHECK(!GetPrimBuff(32)&&!re4dc_prim_tail(32,0)&&work.prim==saved);
    pG->vtx_buf_no=1;pG->nPrim=UINT_MAX;CHECK(!re4dc_prim_recipe_room(&room));
    pG->vtx_buf_no=0;pG->nPrim=64;pG->prim_cnt=reinterpret_cast<void*>(~std::uintptr_t(0)-31);work.prim=static_cast<u8*>(pG->prim_cnt);CHECK(!GetPrimBuff(32)&&!re4dc_prim_tail(32,0));
    reset();data_keys[0].weight_ext_num=UINT_MAX;int built=0;m={};CHECK(!skinDeferPending(&m,&info_keys[0],&data_keys[0],&built)&&!re4dc_skin_defer_lazy(&info_keys[0],&data_keys[0])&&!re4dc_skin_defer(&info_keys[0],&data_keys[0])&&used()==0&&skin_count==0);
}
void full_oom_and_terminals(){
    reset();cModel m{2};int built=0;
    for(unsigned i=0;i<kSkins;++i)CHECK(re4dc_actor_skin_register(7,&info_keys[i],nullptr,owner_palette,1));
    CHECK(!skinDeferPending(&m,&info_keys[kSkins],&data_keys[kSkins],&built)&&used()==0&&!skin_admission_pending.serial);
    reset();nominate();work.prim=prim_storage+sizeof prim_storage-16384;const unsigned at=used();const auto saved=row();
    CHECK(!skinDeferPending(&m,&info_keys[0],&data_keys[0],&built)&&used()==at&&!re4dc_prim_recipe_credit());same_row(saved,row());
    reset();nominate();skin_admission_serial=UINT_MAX;CHECK(!skinDeferPending(&m,&info_keys[0],&data_keys[0],&built)&&!used());
    reset();nominate();skin_recipe_epoch=UINT_MAX;CHECK(!skinDeferPending(&m,&info_keys[0],&data_keys[0],&built)&&!used());SetPrimBuffPtr();CHECK(skin_recipe_epoch==UINT_MAX);
    // Real source palette replacements drop only the successfully replaced credit.
    reset();nominate(2);pending(m);pending(m,1);CHECK(re4dc_actor_skin_register(7,&info_keys[0],nullptr,owner_palette,1));CHECK(re4dc_prim_recipe_credit()==credit(2));
    reset();nominate(2);pending(m);pending(m,1);Re4dcActorSkinAdmission ticket{};CHECK(re4dc_actor_skin_admit(7,&info_keys[0],nullptr,1,&ticket));CHECK(re4dc_actor_skin_commit(&ticket,owner_palette)&&re4dc_prim_recipe_credit()==credit(2));
    // Placeholder and a non-nominee stay inert / use the established full-palette path.
    reset();nominate();auto p=part(&info_keys[0]);CHECK(!palette(&info_keys[0],0)&&!re4dc_actor_skin_lazy_known(p.info)&&!re4dc_actor_materialize_lazy(&p));
    pending(m,1);CHECK(used()==credit(2)&&!re4dc_prim_recipe_credit());CHECK(palette(&info_keys[1],2));
}
void native_completion_and_retire(){
    cModel m{4};
    for(bool leon:{false,true})for(unsigned passes:{1u,3u}){
        reset();nominate();pending(m);Record record;record.passes=passes;auto b=binding(&info_keys[0]);CHECK(re4dc_actor_skin_acquire(7,&b,1,&record.skin));
        CHECK(re4dc_prim_recipe_credit()==credit(2));const auto saved=record.skin.old[0];
        CHECK((leon?final_leon(record,1,1):final_general(&record,1,1))==1);
        if(passes==3){CHECK(record.skin.serial&&releases==0&&re4dc_prim_recipe_credit()==credit(2)&&record.skin.old[0].palette==saved.palette);CHECK((leon?final_leon(record,2,0):final_general(&record,2,0))==1);}
        CHECK(releases==1&&!record.skin.serial&&!re4dc_prim_recipe_credit()&&!skins[0].info&&!matrix_builds&&!palette_builds&&used()==kSkinRecipeBytes);
    }
    // Both actual final blocks refuse stale authority before ordinary release
    // could restore an old descriptor over a newly nominated source recipe.
    for(bool leon:{false,true}){
        reset();nominate();pending(m);Record record;auto b=binding(&info_keys[0]);
        CHECK(re4dc_actor_skin_acquire(7,&b,1,&record.skin));SetPrimBuffPtr();
        std::memset(prim_storage,0xA5,256);nominate();pending(m);const auto fresh=row();
        CHECK((leon?final_leon(record,1,1):final_general(&record,1,1))==-1);
        CHECK(!releases&&!re4dc_actor_skin_validate(&record.skin)&&re4dc_prim_recipe_credit()==credit(2));
        same_row(fresh,row());CHECK(!matrix_builds&&!palette_builds);
    }
    // Actual pre-choice branch uses ordinary release, retaining the descriptor and credit.
    reset();nominate();pending(m);Record r;auto b=binding(&info_keys[0]);CHECK(re4dc_actor_skin_acquire(7,&b,1,&r.skin));auto saved=r.skin.old[0];CHECK(pre_choice(&r)==-1&&actor_failures==1&&releases==1);CHECK(skins[0].palette==saved.palette&&re4dc_prim_recipe_credit()==credit(2));exact_palette(palette(&info_keys[0],2),m,2);
    // Same numeric frame, same primitive address: owner serial revoke precedes overwrite.
    reset();nominate();pending(m);r={};CHECK(re4dc_actor_skin_acquire(7,&b,1,&r.skin));auto stale=r.skin;unsigned epoch=skin_recipe_epoch;Re4dcActorSkinAdmission ticket{};CHECK(re4dc_actor_skin_admit(7,&info_keys[1],nullptr,2,&ticket));auto copy=ticket;
    SetPrimBuffPtr();CHECK(source_retires==1&&workspace_retires==1&&skin_recipe_epoch==epoch+1&&!used()&&!re4dc_prim_recipe_credit()&&!re4dc_actor_skin_validate(&stale));
    std::memset(prim_storage,0xA5,256);CHECK(!re4dc_actor_skin_finish_owner(&stale)&&!re4dc_actor_skin_release(&stale)&&!re4dc_actor_skin_commit(&copy,owner_palette));
    nominate();pending(m);CHECK(skins[0].materialized==kSkinRecipePending&&re4dc_prim_recipe_credit()==credit(2));CHECK(!re4dc_actor_skin_finish_owner(&stale)&&re4dc_prim_recipe_credit()==credit(2));
    // No-buffer early return still revokes leases, recipes, credit and epoch.
    r={};CHECK(re4dc_actor_skin_acquire(7,&b,1,&r.skin));stale=r.skin;epoch=skin_recipe_epoch;pG->prim_cnt=nullptr;SetPrimBuffPtr();CHECK(skin_recipe_epoch==epoch+1&&!re4dc_prim_recipe_credit()&&!re4dc_actor_skin_validate(&stale)&&!re4dc_actor_skin_finish_owner(&stale));
    // A successful source-frame switch also retires hidden recipes and old owner authority.
    reset();nominate();pending(m);r={};CHECK(re4dc_actor_skin_acquire(7,&b,1,&r.skin));stale=r.skin;pG->Frame_cnt=8;const void*keys[]={&info_keys[1]};CHECK(re4dc_actor_skin_reserve(8,keys,1));CHECK(!re4dc_prim_recipe_credit()&&!re4dc_actor_skin_validate(&stale)&&skin_frame==8);
}
void reentry_probe(){
    auto b=binding(&info_keys[0]);Re4dcActorSkinLease lease{};Re4dcActorSkinAdmission ticket{};const void*keys[]={&info_keys[1]};
    CHECK(skin_recipe_building&&!re4dc_actor_skin_register(7,&info_keys[1],nullptr,owner_palette,1));
    CHECK(!re4dc_actor_skin_admit(7,&info_keys[1],nullptr,1,&ticket)&&!re4dc_actor_skin_acquire(7,&b,1,&lease)&&!re4dc_actor_skin_reserve(7,keys,1));
    CHECK(!re4dc_actor_skin_release(&lease)&&!re4dc_actor_skin_finish_owner(&lease));
    auto p=part(&info_keys[0]);CHECK(!re4dc_actor_skin_palette(p.info,nullptr,&p.position_count));
}
void reentry_and_geometry_failure(){
    reset();nominate();cModel m{3};pending(m);build_reentry=reentry_probe;CHECK(palette(&info_keys[0],2)&&palette_builds==1);build_reentry=nullptr;
    reset();nominate();pending(m);CHECK(GetPrimBuff(int(sizeof prim_storage-used()-credit(2))));auto p=part(&info_keys[0]);re4dc_actor_materialize(&p);CHECK(skins[0].materialized==kSkinRecipeReady&&!info_keys[0].pPosBuf[0]&&!skin_calls&&!re4dc_prim_recipe_credit());CHECK(!re4dc_actor_materialize_lazy(&p));
}
