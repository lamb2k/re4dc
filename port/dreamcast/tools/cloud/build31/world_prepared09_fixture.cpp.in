unsigned sourceWorldPackageGeneration=1;
static unsigned heap_limit=1024*1024,heap_used=0,heap_overhead=0,fail_at=0,attempts=0,allocations=0,frees=0;
struct Cell {unsigned bytes,charged,generation,token;};
static std::unordered_map<void*,Cell> blocks;
static unsigned room_generation=7,package_generation=7,source_cell_token=10000,next_cell_token=0;static bool room_live=true,zero_cell_token=false;
static void (*after_allocate)()=nullptr;static void (*before_free)()=nullptr;static void* returned_candidate=nullptr;
extern "C" int re4dc_room4_live_generation(unsigned* out){*out=room_generation;return room_live;}
extern "C" int re4dc_room4_cell_valid(const void* p,unsigned bytes,unsigned generation){
    if(!room_live || generation!=room_generation)return 0;
    if(p==ps2w.storage)return generation==package_generation && bytes==ps2w.bytes;
    auto it=blocks.find(const_cast<void*>(p));return it!=blocks.end() && it->second.generation==generation && it->second.bytes==bytes;
}
static bool verify_close=false;static unsigned leased_token=0;
extern "C" unsigned re4dc_room4_cell_incarnation(const void* p,unsigned bytes,unsigned generation){
    if(!re4dc_room4_cell_valid(p,bytes,generation))return 0;
    if(p==ps2w.storage)return source_cell_token;
    return blocks.at(const_cast<void*>(p)).token;
}
void verify_revoked();
int re4dc_static_heap_free(){return int(heap_limit)-int(heap_used);}
extern "C" void* re4dc_world_part_plan29_alloc(unsigned bytes){
    ++attempts;if((fail_at && bytes>=fail_at) || bytes>heap_limit-heap_used)return nullptr;
    void* p=std::malloc(bytes);assert(p);blocks[p]={bytes,bytes+heap_overhead,room_generation,zero_cell_token?0:++next_cell_token};heap_used+=bytes+heap_overhead;++allocations;
    if(after_allocate){returned_candidate=p;std::memset(p,0x5a,bytes);auto fn=after_allocate;after_allocate=nullptr;fn();}
    return p;
}
void re4dc_static_free(void* p){if(!p)return;if(verify_close)verify_revoked();if(before_free){auto fn=before_free;before_free=nullptr;fn();}auto it=blocks.find(p);assert(it!=blocks.end());heap_used-=it->second.charged;blocks.erase(it);std::free(p);++frees;}
