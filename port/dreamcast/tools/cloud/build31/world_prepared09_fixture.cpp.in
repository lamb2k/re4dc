bool r11fNativeClaimed(){return r11f_claimed;}
static float outer[6]{-10,-10,-10,10,10,10};
#define PC_OUTER_RENDER outer
#define RE4DC_PS2_AFFINE affine
static unsigned view_setups=0;
int placement_setup(unsigned target,bool moved=false){
    for(unsigned i=target;i==target;++i){
        const auto& pl=ps2w.placements[i];float copy[12];std::memcpy(copy,pl.affine,sizeof(copy));const float* affine=moved?copy:pl.affine;
@EARLY@
        ++view_setups;return 1;
    }
    return 0;
}
static unsigned packet_aborts=0;
void re4dc_model_packet_abort(){++packet_aborts;}
static int guarded_record_index(const re4dc::wp29::Record* plan,unsigned plan_incarnation){
    struct {unsigned aborts=0;}c;
@RECORD_GUARD@
    return plan?int(plan->index):0;
}
static const Ps2Part* metadata_address(const re4dc::wp29::Record* plan,unsigned k){
    Mesh mesh;
@METADATA@
    return &meta;
}
static void external_retire_all(){for(auto cell:blocks){std::free(cell.first);++frees;}blocks.clear();heap_used=0;}
static void reset_heap(){wplan29::close();CHECK(blocks.empty());++room_generation;package_generation=room_generation;++source_cell_token;heap_limit=1024*1024;heap_overhead=fail_at=0;verify_close=false;zero_cell_token=false;}
static void reenter_open(){wplan29::close();wplan29::open();}
static void reenter_free(){wplan29::open();}

int main(){
    using namespace re4dc::wp29;
    for(unsigned n:{0U,1U,2U,2048U,0xffffffffU})for(unsigned budget:{0U,32U,100U,kMaxBytes}){
        auto extra=optional_bounds(32,n,budget);
        CHECK(!extra.count || (extra.count==n && extra.bytes<=budget && extra.bytes<=kMaxBytes));
        CHECK(extra.count || extra.bytes==32);
    }
    placements[1].placement=1;placements[1].affine[3]=100;
    wplan29::open();CHECK(wplan29::records && wplan29::box_count==2 && wplan29::bytes<=kMaxBytes+31);
    unsigned count=123;const auto* record=wplan29::run(0,0,count);CHECK(record && count==1 && record->key[0]==1);
    CHECK(metadata_address(record,0)==ps2w.parts+record->index);
    leased_token=wplan29::bound_incarnation;CHECK(wplan29::current(leased_token));
    const auto* box=wplan29::bounds(1,leased_token);CHECK(box && box->center[0]==100);
    unsigned before=view_setups;CHECK(placement_setup(1)==0 && view_setups==before); // before any view setup
    CHECK(placement_setup(0)==1); // inside house retains ordinary path
    wp29::proof=false;CHECK(placement_setup(1)==1);wp29::proof=true;
    dyn::values[1]=0;dyn::slot_of[0]=0;CHECK(placement_setup(1)==1);dyn::values[1]=255;dyn::slot_of[0]=255;
    dyn::ids=nullptr;CHECK(placement_setup(1)==1);dyn::ids=dyn::values;
    dyn::nids=1;CHECK(placement_setup(1)==1);dyn::nids=2;
    CHECK(placement_setup(1,true)==1);
    group_claimed=true;CHECK(placement_setup(1)==1);group_claimed=false;
    r11f_claimed=true;CHECK(placement_setup(1)==1);r11f_claimed=false;
    pc::hide=false;CHECK(placement_setup(1)==1);pc::hide=true;
    ++sourceWorldPackageGeneration;CHECK(!wplan29::current(leased_token));count=123;CHECK(!wplan29::run(0,0,count) && count==123);CHECK(placement_setup(1)==1);
    wplan29::open();CHECK(wplan29::current(wplan29::bound_incarnation) && !wplan29::current(leased_token));
    leased_token=wplan29::bound_incarnation;++source_cell_token;CHECK(!wplan29::current(leased_token));
    meta[0].width=128;++sourceWorldPackageGeneration;wplan29::open();count=0;record=wplan29::run(0,0,count);CHECK(record && record->key[2]==128 && metadata_address(record,0)->width==128);
    meta[0].width=64;++sourceWorldPackageGeneration;wplan29::open();
    leased_token=wplan29::bound_incarnation;verify_close=true;wplan29::close();verify_close=false;
    CHECK(!wplan29::current(leased_token) && !wplan29::bounds(1,leased_token));
    // Actual same-address archive restoration runs close/open: old tokens stay revoked.
    wplan29::open();CHECK(!wplan29::current(leased_token));leased_token=wplan29::bound_incarnation;
    ps2w.storage=reinterpret_cast<void*>(2);CHECK(!wplan29::current(leased_token));ps2w.storage=reinterpret_cast<void*>(1);
    // Forced same-frame heap reset before close: memory is retired externally,
    // and stale close must not free the replacement allocation/address.
    leased_token=wplan29::bound_incarnation;++room_generation;
    CHECK(!wplan29::current(leased_token));
    for(auto cell:blocks){std::free(cell.first);++frees;}blocks.clear();heap_used=0;
    wplan29::close();CHECK(!wplan29::records && !wplan29::current(leased_token));
    package_generation=room_generation;wplan29::open();CHECK(!wplan29::current(leased_token));
    room_live=false;CHECK(!wplan29::current(wplan29::bound_incarnation));room_live=true;
    // Same-generation/address/size recycling is distinct from a heap reset.
    leased_token=wplan29::bound_incarnation;void* foreign=wplan29::allocation;
    const auto* foreign_record=wplan29::records;
    auto& foreign_cell=blocks.at(foreign);const unsigned old_cell=foreign_cell.token;
    foreign_cell.token=++next_cell_token;CHECK(foreign_cell.token!=old_cell);
    std::memset(foreign,0x6b,foreign_cell.bytes);
#ifdef __SANITIZE_ADDRESS__
    __asan_poison_memory_region(foreign,foreign_cell.bytes);
#endif
    CHECK(!wplan29::current(leased_token));count=123;CHECK(!wplan29::run(0,0,count) && count==123);CHECK(!wplan29::bounds(1,leased_token));
    unsigned aborts_before=packet_aborts;CHECK(guarded_record_index(foreign_record,leased_token)==-1 && packet_aborts==aborts_before+1);
    unsigned freed_before=frees;wplan29::close();CHECK(frees==freed_before && blocks.count(foreign));
#ifdef __SANITIZE_ADDRESS__
    __asan_unpoison_memory_region(foreign,foreign_cell.bytes);
#endif
    re4dc_static_free(foreign);CHECK(!blocks.count(foreign));
    reset_heap();wplan29::open();void* retiring=wplan29::allocation;before_free=reenter_free;
    wplan29::open();CHECK(wplan29::records && wplan29::allocation!=retiring && blocks.size()==1);
    CHECK(wplan29::current(wplan29::bound_incarnation));
    // An allocator callback may publish a newer plan. The outer call must
    // neither overwrite its globals nor write through its returned old buffer.
    reset_heap();after_allocate=reenter_open;wplan29::open();
    CHECK(wplan29::records && wplan29::allocation!=returned_candidate);
    CHECK(static_cast<unsigned char*>(returned_candidate)[0]==0x5a);
    CHECK(wplan29::unproven_return_bytes>0 && blocks.size()==2);
    wplan29::close();CHECK(blocks.size()==1);unsigned attempt_count=attempts;
    wplan29::open();CHECK(!wplan29::records && attempts==attempt_count);
    external_retire_all(); // only owning heap retirement reclaims unproven cells
    reset_heap();zero_cell_token=true;wplan29::open();CHECK(!wplan29::records && wplan29::unproven_return_bytes>0);
    attempt_count=attempts;wplan29::open();CHECK(attempts==attempt_count);
    external_retire_all();zero_cell_token=false;
    // Optional-tail failure and post-allocation headroom both retain base records.
