@RESET_DEFERRED@
extern "C" void* re4dc_model_deferred_storage(unsigned* n){*n=0;return nullptr;}
extern "C" void re4dc_model_result(unsigned,unsigned,unsigned){}
@DEFER@
static const auto kSubscreenQuadTag=reinterpret_cast<DeferredLighting*>(uintptr_t(1));
constexpr unsigned kSubscreenQuadNode=(sizeof(DeferredPart)+31)&~31U;
static void submit_fixture(const Re4dcModelPart*);
extern "C" void re4dc_model_submit(const Re4dcModelPart* p){submit_fixture(p);}
@FINISH@
extern "C" void re4dc_model_invalidate_static_lighting(){}
@INVALIDATE@

static unsigned bits(float f){unsigned v;std::memcpy(&v,&f,4);return v;}
static Re4dcModelPart part(unsigned id=1,unsigned blend=0,unsigned texture=0){
    Re4dcModelPart p{};p.model=reinterpret_cast<void*>(uintptr_t(0x1000+id*16));p.info=p.model;p.part=p.model;
    p.image={reinterpret_cast<void*>(uintptr_t(0x100000+texture*4096)),nullptr,64,64,5,0,0};
    p.position_count=3;p.position_stride=6;p.cull=2;p.blend=blend;p.depth_mode=blend?1:0;
    p.source_key[3]=re4dc::sob33::marker(1,blend);p.modelview[0]=1;p.modelview[5]=1;p.modelview[10]=1;p.modelview[3]=float(id);
    p.uv_offset[0]=float(id)*0.125f;p.alpha_state=blend?192:255;return p;
}
static Packet vertex(const Re4dcModelPart& p,unsigned j,bool end){
    Packet v{};v.flags=end?PVR_CMD_VERTEX_EOL:PVR_CMD_VERTEX;
    v.word[0]=bits(p.modelview[3]+float(j));v.word[1]=bits(float(j)+p.modelview[7]);v.word[2]=bits(0.5f);
    v.word[3]=bits(p.uv_offset[0]+float(j)*0.25f);v.word[4]=bits(float(j)*0.5f);
    v.word[5]=0xff000000U|(unsigned(uintptr_t(p.part))&0xffffffU);v.word[6]=0;return v;
}
static bool use_direct=true;
static unsigned emit_count=3;
static bool abort_after_begin=false;
static void submit_fixture(const Re4dcModelPart* p){
    if(use_direct){
        Re4dcModelDirect d{};const int ok=re4dc_model_direct_begin(p,&d);returns.push_back(ok);if(!ok)return;
        for(unsigned j=0;j<emit_count;++j){const Packet v=vertex(*p,j,j+1==emit_count);std::memcpy(d.sq+j*8,&v,32);sq_flush(d.sq+j*8);}
        if(abort_after_begin)re4dc_model_packet_abort();
        re4dc_model_direct_end(emit_count);
    }else {
        Re4dcModelPacket d{};const int ok=re4dc_model_packet_begin(p,&d);returns.push_back(ok);if(!ok)return;
        assert(emit_count<=d.capacity);
        for(unsigned j=0;j<emit_count;++j)static_cast<Packet*>(d.vertices)[j]=vertex(*p,j,j+1==emit_count);
        if(abort_after_begin)re4dc_model_packet_abort();else re4dc_model_packet_commit(emit_count);
    }
    pin_events.push_back(entries[(uintptr_t(p->image.pixels)>>12)&7].frame);
}
static void foreign(unsigned id){
    pvr_poly_hdr_t h{};h.cmd=0x82840002U;h.words[2]=0x900000U+id;
    Packet packets[4];std::memcpy(packets,&h,32);auto p=part(1000+id,1);
    for(unsigned j=0;j<3;++j)packets[j+1]=vertex(p,j,j==2);
    stream_send(packets,sizeof(packets));
}
static void enqueue_foreign(unsigned id){
    constexpr unsigned bytes=kSubscreenQuadNode+128;
    assert(deferred_top>=bytes+8192);deferred_top-=bytes;
    auto* n=new(frame_storage+deferred_top) DeferredPart{};n->lighting=kSubscreenQuadTag;n->changed[0]=128;
    auto* p=reinterpret_cast<Packet*>(frame_storage+deferred_top+kSubscreenQuadNode);
    pvr_poly_hdr_t h{};h.cmd=0x82840002U;h.words[2]=0x900000U+id;std::memcpy(p,&h,32);
    auto view=part(1000+id,1);for(unsigned j=0;j<3;++j)p[j+1]=vertex(view,j,j==2);
    if(deferred_last)deferred_last->next=n;else deferred_first=n;deferred_last=n;++deferred_count;
}
static std::uint64_t digest(const std::vector<unsigned>& v){std::uint64_t h=1469598103934665603ULL;for(unsigned x:v){h^=x;h*=1099511628211ULL;}return h;}
static void reset(){
    assert(!locked&&!direct_open);reset_deferred();retire_boundary();
    model_packets=storage;model_used=model_pending=0;frame=100;scene=1;frame_pvr_calls=frame_pvr_bytes=0;
    stream_model_bytes=stream_peak_bytes=model_peak=0;stream_scene=frame_ready=true;stream_aborted=false;
    desired_list=stream_list=stream_closed_lists=0;draining_parts=source_draws_finished=false;ui_order=false;
    frame_queue_drops=frame_queue_peak=0;next_pcw_set=next_pcw_clear=re4dc_mv_receiver=0;
    lock_calls=unlock_calls=header_count=vertex_count=0;asset_textures=asset_accepts=asset_packets=0;
    direct_parts=direct_slots=0;model_handle=nullptr;storage_ok=load_ok=true;
    effective.clear();returns.clear();pin_events.clear();logical_packets.clear();std::fill(active_valid,active_valid+5,false);std::fill(strip_open,strip_open+5,false);
    for(unsigned i=0;i<8;++i){entries[i]={};entries[i].key={i+1,i+17};entries[i].package.address=0x8000+i*4096;}
    use_direct=true;emit_count=3;abort_after_begin=false;
#if RE4DC_STATIC_OBJ_BATCH33
    sob33_stats={};
#endif
}
static void report(unsigned id){
    assert(!locked&&!direct_open);if(!stream_aborted)for(bool x:strip_open)assert(!x);
    assert(frame_pvr_bytes==32U*(header_count+vertex_count));
#if RE4DC_STATIC_OBJ_BATCH33
    unsigned barrier_sum=0;
    for(unsigned i=0;i<re4dc::sob33::BarrierCount;++i){barrier_sum+=sob33_stats.barrier_causes[i];barrier_seen[i]|=sob33_stats.barrier_causes[i]!=0;}
    assert(barrier_sum==sob33_stats.barriers);
    const unsigned scenario=id%100;
    const auto has=[&](re4dc::sob33::Barrier cause){assert(sob33_stats.barrier_causes[cause]);};
    if(scenario==4){has(re4dc::sob33::StreamSend);has(re4dc::sob33::DeferredReset);}
    if(scenario==5)has(re4dc::sob33::StreamSend);
    if(scenario==14||scenario==44)has(re4dc::sob33::FrameReset);
    if(scenario==15)has(re4dc::sob33::SceneBoundary);
    if(scenario==16)has(re4dc::sob33::ListBoundary);
    if(scenario==17||scenario==38||scenario==39)has(re4dc::sob33::SourceReset);
    if(scenario==20&&id>=100)has(re4dc::sob33::EmptyPacket);
    if(scenario==23||scenario==48)has(re4dc::sob33::PacketAbort);
    if(scenario>=40&&scenario<=43)has(re4dc::sob33::ForeignDirect);
    if(scenario>=45&&scenario<=47)has(re4dc::sob33::CustomPacket);
    if(id%100==0){assert(sob33_stats.category_seen[0]==12);assert(sob33_stats.category_reused[0]==11);}
    if(id%100>=1&&id%100<=3){const unsigned n=id%100==1?17:id%100==2?65:257;assert(sob33_stats.category_seen[1]==n);assert(sob33_stats.category_reused[1]==n-1);}
    if(id%100==4){assert(sob33_stats.category_seen[2]==4);assert(sob33_stats.category_reused[2]==2);}
#endif
    assert(std::fwrite(&id,4,1,trace_file)==1);
    for(const auto* v:{&effective,&returns,&pin_events,&logical_packets}){
        const unsigned n=unsigned(v->size());assert(std::fwrite(&n,4,1,trace_file)==1);
        if(n)assert(std::fwrite(v->data(),4,n,trace_file)==n);
    }
    std::printf("{\"case\":%u,\"semantic\":\"%016llx\",\"vertices\":%u,\"headers\":%u,\"returns\":\"%016llx\",\"pins\":\"%016llx\",\"locks\":%u,\"unlocks\":%u,\"aborted\":%u,\"queue_drops\":%u}\n",
        id,(unsigned long long)digest(effective),vertex_count,header_count,(unsigned long long)digest(returns),(unsigned long long)digest(pin_events),lock_calls,unlock_calls,unsigned(stream_aborted),frame_queue_drops);
}
static void helper_controls(){
    using namespace re4dc::sob33;
    unsigned admitted=0;
    for(unsigned kind=0;kind<4;++kind)for(unsigned id=0;id<256;++id){
        const bool expected=(kind==0&&(id==0x41||id==0x43||id==0x45||id==0x46))||(kind==1&&id==0x21);
        assert(eligible_class(kind,id)==expected);admitted+=eligible_class(kind,id);
    }
    assert(admitted==5);
    const unsigned base[8]={0x80840002U,0x96000000U,0x2080040U,0x8000,0,0,0,0};
    auto seed=[&](){Run r;assert(r.begin(base,100,0,0,true)==First);assert(r.finish(100,0,128,3,true));return r;};
    {auto r=seed();assert(r.begin(base,100,0,128,true)==Reuse);assert(r.finish(100,0,224,3,true));}
    for(unsigned word=0;word<8;++word)for(unsigned bit=0;bit<32;++bit){
        auto r=seed();unsigned h[8];std::copy(base,base+8,h);h[word]^=1U<<bit;
        assert(r.begin(h,100,0,128,true)!=Reuse);
    }
    for(unsigned list=0;list<8;++list){auto r=seed();assert(r.begin(base,100,list,128,true)==(list==0?Reuse:Format));}
    {auto r=seed();assert(r.begin(nullptr,100,0,128,true)==Format);assert(!r.finish(100,0,256,3,true));}
    {auto r=seed();assert(r.begin(base,100,0,128,false)==Foreign);assert(!r.finish(100,0,256,3,true));}
    {auto r=seed();assert(r.begin(base,101,0,128,true)==Boundary);assert(r.finish(101,0,256,3,true));}
    {auto r=seed();assert(r.begin(base,100,0,160,true)==Boundary);assert(r.finish(100,0,288,3,true));}
    {auto r=seed();r.barrier();assert(r.begin(base,100,0,128,true)==First);}
    {Run r;assert(r.begin(base,100,0,0,true)==First);assert(r.begin(base,100,0,32,true)==First);}
    for(unsigned n:{0U,1U,3U,32767U,32768U})for(unsigned complete=0;complete<2;++complete){
        auto r=seed();assert(r.begin(base,100,0,128,true)==Reuse);
        const bool expected=n>0&&n<=32767&&complete;
        assert(r.finish(100,0,128+n*32,n,complete)==expected);
        assert(r.begin(base,100,0,128+n*32,true)==(expected?Reuse:First));
    }
    for(unsigned change=0;change<4;++change){auto r=seed();assert(r.begin(base,100,0,128,true)==Reuse);
        assert(!r.finish(change==0?101:100,change==1?2:0,change==2?192:change==3?256:224,3,true));}
    {auto r=seed();assert(!r.finish(100,0,128,3,true));}
}
int main(int argc,char** argv){
    assert(argc==2);trace_file=std::fopen(argv[1],"wb");assert(trace_file);
    helper_controls();
    for(unsigned route=0;route<2;++route){
        for(unsigned scenario=0;scenario<49;++scenario){
            reset();use_direct=route==0;const unsigned id=route*100+scenario;auto a=part(1),b=part(2);
            if(scenario==0){for(unsigned i=0;i<12;++i){auto p=part(i+1);submit_fixture(&p);}}
            else if(scenario<=3){const unsigned n=scenario==1?17:scenario==2?65:257;for(unsigned i=0;i<n;++i){auto p=part(i+1);p.model=p.info=reinterpret_cast<void*>(uintptr_t(0x8000));p.modelview[3]=40;p.source_key[3]=re4dc::sob33::marker(n,0);submit_fixture(&p);}}
            else if(scenario==4){a=part(1,1);b=part(2,1);assert(defer_part(&a,nullptr)==1);assert(defer_part(&b,nullptr)==1);enqueue_foreign(7);a=part(3,1);assert(defer_part(&a,nullptr)==1);b=part(4,1);assert(defer_part(&b,nullptr)==1);re4dc_model_finish_source_draws();}
            else if(scenario==36){
                a=part(1,1);b=part(2,1);b.source_key[3]=re4dc::sob33::marker(65,1);
                assert(defer_part(&a,nullptr)==1);assert(defer_part(&b,nullptr)==1);
                assert(restore_view(deferred_first).source_key[3]==a.source_key[3]);
                assert(restore_view(deferred_first->next).source_key[3]==b.source_key[3]);
                a.source_key[3]=b.source_key[3]=0;re4dc_model_finish_source_draws();
            }
            else if(scenario==37&&use_direct){
                Re4dcModelDirect d{},nested{};int result=re4dc_model_direct_begin(&a,&d);returns.push_back(result);assert(result);
                result=re4dc_model_direct_begin(&b,&nested);returns.push_back(result);assert(!result);
                for(unsigned j=0;j<3;++j){auto v=vertex(a,j,j==2);std::memcpy(d.sq+j*8,&v,32);sq_flush(d.sq+j*8);}
                re4dc_model_direct_end(3);submit_fixture(&b);
            }
            else if(scenario>=45&&scenario<=47){
                ui_order=true;a.cull=0;a.material_flags=4;a.mask=a.image;a.mask_ref=0;a.mask_same_uv=1;
                if(scenario!=45){a.depth_mode=1;a.wrap_s=a.wrap_t=1;}
                b=a;b.part=reinterpret_cast<void*>(uintptr_t(0x4000));submit_fixture(&a);
                Re4dcModelPacket p{};int ok;
                if(scenario==45)ok=re4dc_model_pt_begin(1,17,64,64,0,&p);
                else if(scenario==46)ok=re4dc_ps2_world_packet(1,17,64,64,2,&p);
                else ok=re4dc_ps2_world_packet_cull(1,17,64,64,2,2,&p);
                assert(ok);returns.push_back(ok);
#if RE4DC_STATIC_OBJ_BATCH33
                assert(!sob33_packet_eligible&&!sob33_run.valid&&!sob33_run.pending);
#endif
                for(unsigned j=0;j<3;++j)static_cast<Packet*>(p.vertices)[j]=vertex(b,j,j==2);
                re4dc_model_packet_commit(3);submit_fixture(&b);
#if RE4DC_STATIC_OBJ_BATCH33
                assert(header_count==3&&sob33_stats.decisions[re4dc::sob33::Foreign]==1);
#endif
            }
            else if(scenario==48){
                use_direct=false;submit_fixture(&a);Re4dcModelPacket p{};
                const int ok=re4dc_model_packet_begin(&b,&p);assert(ok);returns.push_back(ok);
                for(unsigned j=0;j<3;++j)static_cast<Packet*>(p.vertices)[j]=vertex(b,j,false);
                re4dc_model_packet_commit(3);
#if RE4DC_STATIC_OBJ_BATCH33
                assert(!sob33_run.valid&&!sob33_run.pending);
                assert(header_count==2&&sob33_stats.decisions[re4dc::sob33::Format]==1);
#endif
                // A deliberately incomplete producer cannot be presented; the
                // existing abort contract rejects every subsequent begin.
                re4dc_model_packet_abort();submit_fixture(&a);assert(stream_aborted);
            }
            else {
                submit_fixture(&a);
                if(scenario==5)foreign(3);
                if(scenario==6)b.cull=1;
                if(scenario==7)b.blend=2;
                if(scenario==8)b.depth_mode=2;
                if(scenario==9)b.wrap_s=1;
                if(scenario==10)b.source_key[2]=1;
                if(scenario==11)b=part(2,0,1);
                if(scenario==12){b.material_flags=4;b.mask=b.image;b.mask_ref=0;b.mask_same_uv=1;}
                if(scenario==13)b.source_key[3]=0;
                if(scenario==14)frame_boundary();
                if(scenario==15){close_scene();stream_open();}
                if(scenario==16){stream_select(PVR_LIST_TR_POLY);stream_select(PVR_LIST_OP_POLY);}
                if(scenario==17)retire_boundary();
                if(scenario==18)next_pcw_set=1;
                if(scenario==19)re4dc_mv_receiver=1;
                if(scenario==20)emit_count=0;
                if(scenario==21)load_ok=false;
                if(scenario==22){model_packets=nullptr;storage_ok=false;}
                if(scenario==23)abort_after_begin=true;
                if(scenario==24){b.image.width=0;}
                if(scenario==25){source_draws_finished=true;}
                if(scenario==26){entries[0].model_header_key=~0U;entries[0].package.address+=4096;}
                if(scenario==27){use_direct=!use_direct;}
                if(scenario>=28&&scenario<=35){reinterpret_cast<unsigned*>(&entries[0].model_header)[scenario-28]^=scenario==28?0x100U:1U;}
                if(scenario==38)sources_reset();
                if(scenario==39){a=part(5,1);assert(defer_part(&a,nullptr)==1);re4dc_model_invalidate_pending();}
                if(scenario>=40&&scenario<=44)foreign_direct_boundary(scenario-40);
                submit_fixture(&b);
                emit_count=3;load_ok=storage_ok=true;abort_after_begin=false;re4dc_mv_receiver=0;next_pcw_set=next_pcw_clear=0;
                auto c=part(3);submit_fixture(&c);
            }
            report(id);
        }
    }
#if RE4DC_STATIC_OBJ_BATCH33
    for(bool seen:barrier_seen)assert(seen);
#endif
    assert(std::fclose(trace_file)==0);
}
