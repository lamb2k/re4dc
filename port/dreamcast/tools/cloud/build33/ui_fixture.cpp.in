    struct {unsigned culling=0,fog_type=0;} gen;
    struct {unsigned comparison=0,write=0;} depth;
    struct {unsigned src=0,dst=0;} blend;
    struct {unsigned env=0,alpha=0,uv_clamp=0;} txr;
