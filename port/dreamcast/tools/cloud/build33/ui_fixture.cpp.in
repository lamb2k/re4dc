static void capture(const void* ptr,unsigned bytes){
    assert(bytes%32==0);
    const auto* words=static_cast<const unsigned*>(ptr);
    for(unsigned i=0;i<bytes/4;i+=8){
        const unsigned* p=words+i;
        const unsigned type=p[0]>>29;
        assert(stream_list<5);
        if(type==4 || type==5){
            assert(!strip_open[stream_list]);
            std::copy(p,p+8,active_header[stream_list].begin());
            active_valid[stream_list]=true;++header_count;
        }else if(type==7){
            assert(active_valid[stream_list]);
            effective.push_back(scene);effective.push_back(stream_list);
            effective.insert(effective.end(),active_header[stream_list].begin(),active_header[stream_list].end());
            effective.insert(effective.end(),p,p+8);++vertex_count;
            strip_open[stream_list]=(p[0]&0x10000000U)==0;
        }else { assert(false && "Unexpected fixture TA packet"); }
    }
}
static std::uint32_t* sq_lock(void*){assert(!locked);locked=true;++lock_calls;return sq_storage;}
static void sq_unlock(){assert(locked);locked=false;++unlock_calls;}
static void sq_flush(std::uint32_t* p){assert(locked);assert(p>=sq_storage&&p+8<=sq_storage+8*32770);capture(p,32);}
static int pvr_list_finish(){assert(locked);assert(!strip_open[stream_list]);return 0;}
static int pvr_list_begin(unsigned){assert(locked);return 0;}
static void re4dc_missing(const char*){++missing;}
static void re4dc_log(const char*,...){++logs;}
extern "C" int re4dc_model_diagnostic_enabled(){return 1;}
static bool ensure_model_storage(){if(!model_packets&&storage_ok)model_packets=storage;return model_packets!=nullptr;}
static Entry* resolve(const Re4dcUiImage& image,const Re4dcModelPart*,bool){
    assert(!locked);++loads;if(!load_ok)return nullptr;
    const auto index=(uintptr_t(image.pixels)>>12)&7;
    return entries[index].valid?&entries[index]:nullptr;
}
static Entry* load(const Re4dcUiImage&,bool,const Key* key){assert(!locked);++loads;if(!load_ok)return nullptr;return &entries[(key->crc-1)&7];}
static unsigned re4dc_ps2_world_fog(){return 0;}
static void fixture_asset(const void* data,unsigned bytes,unsigned list){
    ++asset_packets;logical_packets.push_back(bytes);logical_packets.push_back(list);
    const auto* p=static_cast<const unsigned*>(data);logical_packets.insert(logical_packets.end(),p,p+bytes/4);
}
