namespace re4dc::render {
static void begin_pvr_packet(Packet* p,std::uint32_t& n,const pvr_poly_hdr_t& h){std::memcpy(p,&h,32);n=1;}
static void submit_pvr(const void* p,unsigned n){assert(locked);capture(p,n);}
}
static void pvr_poly_cxt_txr(pvr_poly_cxt_t* c,unsigned list,unsigned fmt,unsigned w,unsigned h,void* addr,unsigned){
    *c={};c->list=list;c->format=fmt;c->width=w;c->height=h;c->address=unsigned(uintptr_t(addr));
}
static void pvr_poly_compile(pvr_poly_hdr_t* h,const pvr_poly_cxt_t* c){
    h->cmd=0x80840002U|(c->list<<24);
    h->words[0]=(c->gen.culling<<24)|(c->depth.comparison<<16)|(c->depth.write<<8)|c->txr.alpha;
    h->words[1]=(c->gen.fog_type<<28)|(c->blend.src<<24)|(c->blend.dst<<20)|(c->txr.uv_clamp<<18)|(c->width<<8)|c->height;
    h->words[2]=c->address|(c->format<<26);
    std::fill(h->words+3,h->words+7,0U);
}
@BATCH33_STATE@
@SOURCES_RESET@
static void reset_deferred();
@UI_ORDER_LIST@
@UI_ORDER_HEADER@
static void stream_open(){
    assert(!locked);
    @OPEN_BARRIER@
    stream_scene=true;stream_list=desired_list;
}
static void close_scene(){
    assert(!locked&&!direct_open);
    @CLOSE_BARRIER@
    stream_scene=false;++scene;std::fill(active_valid,active_valid+5,false);
}
static void frame_boundary(){
    assert(!locked&&!direct_open);
    @FRAME_BARRIER@
    ++frame;
}
static void retire_boundary(){
    assert(!locked&&!direct_open);
    @RETIRE_BARRIER@
    // Actual retirement reaches these two production reset functions before
    // clearing owner views; their call anchors are checked by ui_host.py.
    reset_deferred();sources_reset();
}
static void foreign_direct_boundary(unsigned kind){
    assert(!locked&&!direct_open);
    if(kind==0){
        @LEON_BARRIER@
    }else if(kind==1){
        @COARSE_BARRIER@
    }else if(kind==2){
        @COARSE_MODE_BARRIER@
    }else if(kind==3){
        @WORLD_BARRIER@
    }else{
        @SKIP_BARRIER@
    }
}
