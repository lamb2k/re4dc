// Included after the complete production actor TU, compiled unmodified.
// The blob below is generated by the actual offline converter from synthetic
// ModelData; both arms evaluate the same source normals/material/light set.
extern "C" {
Re4dcModelPart fixture_part;
Frame fixture_frame;
SourceLighting fixture_source;
Lights fixture_lights;
alignas(32) short fixture_positions[128*4];
alignas(32) signed char fixture_normals[128*4];
alignas(32) pvr_vertex_t fixture_cache[128];
alignas(32) unsigned char fixture_blob[] = {@BLOB@};
float fixture_center[3];
unsigned fixture_arm, fixture_bake_use;
float re4dc_screen_wf=640, re4dc_screen_hf=480;
void re4dc_log(const char*,...) {}
}
extern "C" void fixture_prepare(unsigned arm) {
    fixture_arm=arm;fixture_bake_use=0;
    fixture_part=Re4dcModelPart{};fixture_frame=Frame{};
    fixture_source=SourceLighting{};fixture_lights=Lights{};
    fixture_frame.mode=kRigid;fixture_frame.q=0.5f;fixture_frame.nq=1.0f/64.0f;
    fixture_frame.small_normals=true;
    fixture_frame.positions=reinterpret_cast<const u8*>(fixture_positions);
    fixture_frame.position_stride=8;
    fixture_frame.normals=reinterpret_cast<const u8*>(fixture_normals);
    fixture_frame.normal_stride=4;
    fixture_part.lighting=&fixture_source;fixture_part.alpha_state=73;
    fixture_part.model=reinterpret_cast<const void*>(0x123400U);
    fixture_part.modelview[0]=fixture_part.modelview[5]=fixture_part.modelview[10]=1;
    fixture_part.modelview[11]=-32;
    fixture_part.stream=arm?fixture_blob:nullptr;fixture_part.stream_bytes=sizeof(fixture_blob);
    fixture_source.normal_matrix[0]=fixture_source.normal_matrix[5]=fixture_source.normal_matrix[10]=1;
    fixture_source.enable=1;fixture_source.mask=1;fixture_source.diffuse=2;
    for(unsigned c=0;c<3;++c){fixture_source.ambient[c]=64;fixture_source.material[c]=128;}
    SourceLight& light=fixture_source.lights[0];
    light.position[2]=-31;light.direction[2]=1;light.a[0]=1;light.k[0]=1;
    for(unsigned c=0;c<3;++c)light.color[c]=64;
    // A brighter live light exercises the gain path on the same offline bake.
    if(arm==2)for(unsigned c=0;c<3;++c)light.color[c]=128;
    for(unsigned i=0;i<128;++i){fixture_normals[i*4+2]=64;fixture_cache[i].argb=0xaabbccdd;}
}
extern "C" __attribute__((noinline)) unsigned fixture_fold(unsigned) {
    const bool ok=RE4DC_PART_LIGHTS(fixture_part,fixture_frame,fixture_center,fixture_lights);
    if(!ok)RE4DC_PREPARED(fixture_lights)=re4dc::render::prepare_actor_lights(fixture_source);
    return ok;
}
extern "C" __attribute__((noinline)) unsigned fixture_pass(unsigned n) {
    Part e{fixture_part,fixture_frame,{fixture_part.projection,fixture_part.viewport},
           {5.0f,1000.0f,640.0f,480.0f,project,nullptr}};
    e.cache.v=fixture_cache;e.alpha=0x49000000U;
    const auto& blob=*reinterpret_cast<const BlobHeader*>(fixture_blob);
    const unsigned stride=3U+((blob.flags&kHasCi)?1U:0U)+((blob.flags&kHasBake)?1U:0U);
    const Records r{reinterpret_cast<const u16*>(fixture_blob+blob.rec4*4U),stride,blob.color_index,true};
    if(fixture_arm){
        unsigned gain[3];
        const BakeUse use=bake_prepare(e,fixture_lights,blob,stride,gain);
        fixture_bake_use=unsigned(use);
        if(use==kBakeNone)return 0;
        pass_baked(e,r,n,use==kBakeScaled?gain:nullptr);
    }else pass_lights_exact(e,fixture_lights,r,n);
    return fixture_cache[0].argb;
}
extern "C" const uintptr_t fixture_layout[]={
    1,sizeof(Part),sizeof(Frame),sizeof(Lights),sizeof(SourceLighting),sizeof(Re4dcModelPart),
    uintptr_t(&fixture_part),uintptr_t(&fixture_frame),uintptr_t(&fixture_source),uintptr_t(&fixture_lights),
    uintptr_t(fixture_positions),uintptr_t(fixture_normals),uintptr_t(fixture_cache),
    uintptr_t(fixture_blob),sizeof(fixture_blob),uintptr_t(&fixture_bake_use),
    offsetof(pvr_vertex_t,argb)
};
