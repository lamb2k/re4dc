static GXTexObj texture{};
static GXTlutObj palette{};
static void reset_draw(){gx_strips=gx_texture_loads=0;gx_positions.clear();gx_normals.clear();events.clear();native_callback={};native_outcome={Outcome::UnsupportedBeforePublication};}
static unsigned cells(const Cloth&c){return unsigned(c.divH)*c.divV;}
static bool bytes_equal(const Vec*a,const Vec*b,unsigned n){return std::memcmp(a,b,n*sizeof(Vec))==0;}
static void cleanup(Cloth&c){if(allocations.count(c.m_pMem))c.Destroy();c.m_pMem=nullptr;}
static void setup(Cloth&c,unsigned x=4,unsigned y=6,int mode=0){cleanup(c);Vec zero{},pos{0,0,-100};c.Set(zero,pos,u8(x),u8(y),5,&texture,7,nullptr,1,&palette,mode);}
static void initialize_effect(cEsp4e&e,Cloth&c){
    e.m_Free={};e.m_Free.pCl=&c;e.m_Pos={2,3,4};e.m_Speed={1,2,3};
    e.m_Free.time_plus=3;e.m_Free.time_plus2=-2;e.m_Free.pow=5;e.m_Free.pow2=4;
    e.m_Free.range=2.5f;e.m_Free.range2=1.3f;e.m_Free.offset=.2f;
    e.m_Free.wind_time_plus=.07f;e.m_Free.wind_range_pow=.3f;e.m_Free.rand_ratio=.9f;
}
static void step(Cloth&c){cEsp4e effect;initialize_effect(effect,c);effect.move();}
static void initialized_normals(const Cloth&c){for(unsigned i=0;i<cells(c);++i)check(c.pNor[i].x==0&&c.pNor[i].y==0&&c.pNor[i].z==1);}
static std::vector<Vec> normals_copy(const Cloth&c){return {c.pNor,c.pNor+cells(c)};}
static std::vector<Vec> expected_normals(const Cloth&c){
    Cloth ref=c;std::vector<Vec> grid(c.pVer,c.pVer+cells(c));std::vector<Vec> normal(cells(c));
    ref.pVer=grid.data();ref.pNor=normal.data();ref.calcNormal();return normal;
}
static void check_no_replay(unsigned before){check(normal_calls==before);check(gx_normals.empty());check(gx_positions.empty());check(gx_strips==0);check(gx_texture_loads==0);}
static void paired_step(cEsp4e&candidate,cEsp4eControl&control,unsigned seed){
    rng_state=seed;rng_calls=0;events.clear();candidate.move();auto candidate_rng=rng_state;
    auto candidate_calls=rng_calls;auto candidate_trace=events;
    rng_state=seed;rng_calls=0;events.clear();control.move();auto control_trace=events;
    control_trace.erase(std::remove(control_trace.begin(),control_trace.end(),'N'),control_trace.end());
    check(candidate_trace==control_trace);check(rng_state==candidate_rng);check(rng_calls==candidate_calls);
    const Cloth&a=*candidate.m_Free.pCl;const Cloth&b=*control.m_Free.pCl;
    check(bytes_equal(a.pVer,b.pVer,cells(a)));check(bytes_equal(a.pSpd,b.pSpd,cells(a)));
    check(std::memcmp(a.mat,b.mat,sizeof a.mat)==0);check(std::memcmp(&a.color,&b.color,sizeof a.color)==0);
    check(std::memcmp(&candidate.m_Pos,&control.m_Pos,sizeof(Vec))==0);
    const auto&ca=candidate.m_Free;const auto&cb=control.m_Free;
    const float phases_a[]={ca.time,ca.time2,ca.range,ca.range2,ca.offset,ca.wind_time,ca.wind_time_plus,ca.wind_range_pow,ca.rand_ratio};
    const float phases_b[]={cb.time,cb.time2,cb.range,cb.range2,cb.offset,cb.wind_time,cb.wind_time_plus,cb.wind_range_pow,cb.rand_ratio};
    check(std::memcmp(phases_a,phases_b,sizeof phases_a)==0);
    check(ca.time_plus==cb.time_plus&&ca.time_plus2==cb.time_plus2&&ca.pow==cb.pow&&ca.pow2==cb.pow2);
    check(candidate_calls==unsigned(a.divV)*(unsigned(a.divH)+1));
}

static void test_initial_fallback(){
    auto&c=ClothWk[0];unsigned before=normal_calls;events.clear();setup(c);
    check(normal_calls==before);check(std::count(events.begin(),events.end(),'M')==120);
    check(std::count(events.begin(),events.end(),'S')==120*(RE4DC_CLOTH_SPRING==2?2:1));
    check(cloth_normals01[0].pending==0);initialized_normals(c);
    reset_draw();clothTrans(&c);check(normal_calls==before);check(gx_normals.size()==2u*c.divH*(c.divV-1));
    for(auto n:gx_normals)check(n.x==0&&n.y==0&&n.z==1);
    reset_draw();clothTrans(&c);check(normal_calls==before);cleanup(c);
    std::puts("first fallback preserves Set's 120-tick warmup and initialized normals: PASS");
}

static void test_updates(){
    for(auto dims:std::vector<std::pair<unsigned,unsigned>>{{2,2},{4,6},{36,24},{100,50}}){
        for(int mode=0;mode<2;++mode){
            auto&c=ClothWk[1];Cloth ref{};setup(c,dims.first,dims.second,mode);setup(ref,dims.first,dims.second,mode);
            cEsp4e candidate;cEsp4eControl control;initialize_effect(candidate,c);initialize_effect(control,ref);
            if(mode){candidate.parent=control.parent=&local_parent;}
            auto initialized=normals_copy(c);
            for(unsigned tick=0;tick<3;++tick){
                paired_step(candidate,control,0x1234u+tick);check(cloth_normals01[1].pending==1);
                check(bytes_equal(c.pNor,initialized.data(),cells(c)));
                unsigned before=normal_calls;reset_draw();native_outcome={Outcome::Queued,0,1};clothTrans(&c);
                check_no_replay(before);check(cloth_normals01[1].pending==1);
            }
            reset_draw();unsigned before=normal_calls,ops=normal_operations;clothTrans(&c);
            check(normal_calls==before+1);check(normal_operations-ops==(dims.first-1)*(dims.second-1));
            check(cloth_normals01[1].pending==0);check(bytes_equal(c.pNor,ref.pNor,cells(c)));
            auto positions=gx_positions,normals=gx_normals;
            check(std::find(events.begin(),events.end(),'X')<std::find(events.begin(),events.end(),'N'));
            check(std::find(events.begin(),events.end(),'N')<std::find(events.begin(),events.end(),'G'));
            reset_draw();clothTrans(&ref);check(normal_calls==before+1);
            check(gx_positions.size()==positions.size()&&bytes_equal(gx_positions.data(),positions.data(),unsigned(positions.size())));
            check(gx_normals.size()==normals.size()&&bytes_equal(gx_normals.data(),normals.data(),unsigned(normals.size())));
            reset_draw();clothTrans(&c);check(normal_calls==before+1);cleanup(c);cleanup(ref);
        }
    }
    std::puts("8 grid/pin profiles: native-only updates defer, fallback normal bytes match eager control, physics/speed/RNG traces unchanged: PASS");
}

static void test_outcomes(){
    auto&c=ClothWk[2];setup(c);
    for(auto outcome:{Outcome::Submitted,Outcome::Queued,Outcome::Culled,Outcome::PolicySkip,Outcome::UnsupportedBeforePublication,Outcome::Refused,Outcome::PartialAbort}){
        for(unsigned submitted=0;submitted<2;++submitted)for(unsigned queued=0;queued<2;++queued){
            step(c);unsigned before=normal_calls;reset_draw();native_outcome={outcome,submitted,queued};
            const bool fallback=native_outcome.fallback_allowed();clothTrans(&c);
            if(fallback){check(normal_calls==before+1);check(!gx_normals.empty());check(cloth_normals01[2].pending==0);}
            else{check_no_replay(before);check(cloth_normals01[2].pending==1);}
        }
    }
    step(c);unsigned before=normal_calls,native_before=native_calls;float z=c.center.z;c.center.z=100000;
    reset_draw();clothTrans(&c);check_no_replay(before);check(native_calls==native_before);check(cloth_normals01[2].pending==1);
    c.center.z=z;reset_draw();clothTrans(&c);check(normal_calls==before+1);cleanup(c);
    std::puts("28 actual result outcome/publication combinations plus actual view cull: no normal calculation or GX replay after publication/partial abort: PASS");
}

static void test_pool_lifecycle(){
    ClothInit();for(unsigned i=0;i<8;++i){setup(ClothWk[i]);step(ClothWk[i]);check(cloth_normals01[i].pending==1);}
    Cloth* free=nullptr;check(!PullCloth(&free)&&free==nullptr);
    ClothWk[3].Destroy();check(cloth_normals01[3].pending==0);check(PullCloth(&free)&&free==&ClothWk[3]);
    setup(*free);initialized_normals(*free);unsigned before=normal_calls;reset_draw();clothTrans(free);check(normal_calls==before);
    step(*free);void* previous=free->m_pMem;Vec zero{},pos{0,0,-100};
    free->Set(zero,pos,3,5,5,&texture,7,nullptr,1,&palette,0);Mem_free(previous);
    check(cloth_normals01[3].pending==0);initialized_normals(*free);
    before=normal_calls;reset_draw();clothTrans(free);check(normal_calls==before);
    auto allocations_before=allocations.size();ClothRoomInit();check(allocations.size()==allocations_before);
    for(unsigned i=0;i<8;++i){check(cloth_normals01[i].pending==0);check(ClothWk[i].be_flag==0);cleanup(ClothWk[i]);}
    std::puts("all 8 slots, PullCloth reuse, Destroy, Set, Init/RoomInit reset pending without new allocation/lifetime behavior: PASS");
}

static void test_callbacks(){
    auto&c=ClothWk[4];setup(c);step(c);reset_draw();unsigned before=normal_calls;
    native_callback=[](Cloth*p){p->Destroy();};clothTrans(&c);check_no_replay(before);check(cloth_normals01[4].pending==0);cleanup(c);
    setup(c);step(c);reset_draw();before=normal_calls;
    native_callback=[](Cloth*p){p->Destroy();setup(*p,3,7);step(*p);};clothTrans(&c);
    check_no_replay(before);check(cloth_normals01[4].pending==1);auto expected=expected_normals(c);
    reset_draw();before=normal_calls;clothTrans(&c);check(normal_calls==before+1);check(bytes_equal(c.pNor,expected.data(),cells(c)));
    step(c);reset_draw();before=normal_calls;native_callback=[](Cloth*p){step(*p);};clothTrans(&c);
    check_no_replay(before);check(cloth_normals01[4].pending==1);expected=expected_normals(c);
    reset_draw();before=normal_calls;clothTrans(&c);check(normal_calls==before+1);check(bytes_equal(c.pNor,expected.data(),cells(c)));
    step(c);reset_draw();before=normal_calls;native_outcome={Outcome::PartialAbort,0,1};native_callback=[](Cloth*p){step(*p);};clothTrans(&c);
    check_no_replay(before);check(cloth_normals01[4].pending==1);
    reset_draw();before=normal_calls;clothTrans(&c);check(normal_calls==before+1);
    step(c);reset_draw();before=normal_calls;native_callback=[](Cloth*){ClothInit();};clothTrans(&c);
    check_no_replay(before);check(cloth_normals01[4].pending==0);cleanup(c);
    std::puts("native callback retirement/reuse/Init/same-cloth update: changed revision refuses stale fallback and preserves newer pending work: PASS");
}

static void test_eager_and_early_returns(){
    Cloth external{};setup(external);check(cloth_normals_slot01(&external)==8);
    unsigned before=normal_calls;step(external);check(normal_calls==before+1);auto expected=expected_normals(external);
    check(bytes_equal(external.pNor,expected.data(),cells(external)));reset_draw();before=normal_calls;clothTrans(&external);check(normal_calls==before);
    cleanup(external);
    auto&c=ClothWk[5];setup(c);cEsp4e effect;initialize_effect(effect,c);auto revision=cloth_normals01[5].revision;
    common_move_allowed=false;effect.move();common_move_allowed=true;check(cloth_normals01[5].revision==revision);
    effect.m_Free.pCl=nullptr;effect.move();check(cloth_normals01[5].revision==revision);cleanup(c);
    std::puts("off-pool eagerly calculates; CommonMove/null early returns do not mark: PASS");
}

static void test_normal_diagnostics(){
    auto&c=ClothWk[5];setup(c);for(unsigned i=0;i<cells(c);++i)c.pVer[i]={0,0,0};
    unsigned diagnostics=normal_diagnostics;step(c);check(normal_diagnostics==diagnostics);
    reset_draw();native_outcome={Outcome::Queued,0,1};unsigned before=normal_calls;clothTrans(&c);
    check_no_replay(before);check(normal_diagnostics==diagnostics);
    reset_draw();clothTrans(&c);check(normal_calls==before+1);
    check(normal_diagnostics-diagnostics==unsigned(c.divH-1)*(c.divV-1));
    for(auto n:gx_normals)check(n.x==0&&n.y==0&&n.z==0);
    setup(c);for(unsigned i=0;i<cells(c);++i)c.pVer[i]={0,0,0};step(c);
    reset_draw();before=normal_calls;unsigned revision=cloth_normals01[5].revision;
    normal_callback=[&](){step(c);};clothTrans(&c);
    check(normal_calls==before+1);check(cloth_normals01[5].revision!=revision);
    check(cloth_normals01[5].pending==1);check(gx_normals.empty());check(gx_strips==0);check(gx_texture_loads==0);
    auto expected=expected_normals(c);reset_draw();before=normal_calls;clothTrans(&c);
    check(normal_calls==before+1);check(cloth_normals01[5].pending==0);check(bytes_equal(c.pNor,expected.data(),cells(c)));
    cleanup(c);
    std::puts("actual VECNormalize macro: degenerate diagnostics deferred with normals; nonretiring diagnostic update keeps newer pending and refuses GX replay: PASS");
}

static void test_exhaustion(){
    auto&c=ClothWk[6];setup(c);cloth_normals01[6].revision=std::numeric_limits<unsigned>::max();
    unsigned before=normal_calls;step(c);check(normal_calls==before+1);check(cloth_normals01[6].revision==0);check(cloth_normals01[6].pending==0);
    before=normal_calls;step(c);check(normal_calls==before+1);reset_draw();before=normal_calls;clothTrans(&c);check(normal_calls==before);
    cleanup(c);setup(c);check(cloth_normals01[6].revision==0);before=normal_calls;step(c);check(normal_calls==before+1);cleanup(c);
    auto&d=ClothWk[7];setup(d);step(d);cloth_normals01[7].revision=std::numeric_limits<unsigned>::max();
    reset_draw();before=normal_calls;native_callback=[](Cloth*p){step(*p);};clothTrans(&d);
    check(normal_calls==before+1);check(gx_normals.empty());check(gx_strips==0);check(cloth_normals01[7].revision==0);cleanup(d);
    std::puts("revision exhaustion never reuses an old ticket: slot permanently resumes eager calculation; in-flight old ticket refuses replay: PASS");
}

int main(){
