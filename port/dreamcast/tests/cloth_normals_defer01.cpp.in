static unsigned gx_strips,gx_texture_loads;
static std::vector<Vec> gx_positions,gx_normals;
static void GXLoadTexObj(GXTexObj*,int){++gx_texture_loads;}
static void GXBegin(int,int,int){++gx_strips;}
