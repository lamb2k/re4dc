static void event(char code){events.push_back(code);}
static void check(bool condition){++checks;if(!condition){std::fprintf(stderr,"check %u failed\n",checks);std::abort();}}
static void PSVECSubtract(const Vec*a,const Vec*b,Vec*c){*c={a->x-b->x,a->y-b->y,a->z-b->z};}
static void PSVECAdd(const Vec*a,const Vec*b,Vec*c){*c={a->x+b->x,a->y+b->y,a->z+b->z};}
static void PSVECScale(const Vec*a,Vec*b,float s){*b={a->x*s,a->y*s,a->z*s};}
static float PSVECMag(const Vec*a){return std::sqrt(a->x*a->x+a->y*a->y+a->z*a->z);}
static void PSVECCrossProduct(const Vec*a,const Vec*b,Vec*c){*c={a->y*b->z-a->z*b->y,a->z*b->x-a->x*b->z,a->x*b->y-a->y*b->x};}
static void PSVECNormalize(const Vec*a,Vec*b){++normal_operations;float n=PSVECMag(a);check(n>0);PSVECScale(a,b,1.0f/n);}
static std::function<void()> normal_callback;
struct HostLog {
