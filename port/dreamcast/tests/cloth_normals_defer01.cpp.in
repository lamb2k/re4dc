        check(std::strcmp(format,"VECNormalize:[%s/%d]")==0);
        check(std::strcmp(file,"D:/Bio4/Prog/cloth.cpp")==0&&line==622);
        auto callback=normal_callback;normal_callback={};if(callback)callback();
    }
} host_log;
static HostLog* pLog=&host_log;
@ACTUAL_NORMAL_MACRO@
static void PSMTXIdentity(Mtx m){std::memset(m,0,sizeof(Mtx));for(int i=0;i<3;++i)m[i][i]=1;}
static void PSMTXScale(Mtx m,float x,float y,float z){PSMTXIdentity(m);m[0][0]=x;m[1][1]=y;m[2][2]=z;}
static void PSMTXMultVec(const Mtx m,const Vec*v,Vec*out){Vec t={m[0][0]*v->x+m[0][1]*v->y+m[0][2]*v->z+m[0][3],m[1][0]*v->x+m[1][1]*v->y+m[1][2]*v->z+m[1][3],m[2][0]*v->x+m[2][1]*v->y+m[2][2]*v->z+m[2][3]};*out=t;}
static void PSMTXConcat(const Mtx a,const Mtx b,Mtx out){Mtx t{};for(int i=0;i<3;++i){for(int j=0;j<3;++j)for(int k=0;k<3;++k)t[i][j]+=a[i][k]*b[k][j];t[i][3]=a[i][3];for(int k=0;k<3;++k)t[i][3]+=a[i][k]*b[k][3];}std::memcpy(out,t,sizeof t);}
// Fixtures use identity rotation and diagonal scale; these are exact for that domain.
static void PSMTXInverse(const Mtx in,Mtx out){Mtx t{};for(int i=0;i<3;++i){t[i][i]=1/in[i][i];t[i][3]=-in[i][3]/in[i][i];}std::memcpy(out,t,sizeof t);}
static void PSMTXTranspose(const Mtx in,Mtx out){Mtx t{};for(int i=0;i<3;++i)for(int j=0;j<3;++j)t[i][j]=in[j][i];std::memcpy(out,t,sizeof t);}
static void RotMatrix(Mtx m,const Vec*){PSMTXIdentity(m);}
static void low_RotMatrix(Mtx m,const Vec*a){RotMatrix(m,a);}
static void TransMatrix(Mtx m,const Vec*p){m[0][3]=p->x;m[1][3]=p->y;m[2][3]=p->z;}
static void Matrix2AxisAngle(const Mtx,Vec*a){*a={0,0,0};}
static std::set<void*> allocations;
static void* host_alloc(std::size_t n){void*p=std::malloc(n);check(p!=nullptr);check(allocations.insert(p).second);return p;}
static void Mem_free(void*p){check(allocations.erase(p)==1);std::free(p);}
#define MEM_ALLOC(n,a,b) host_alloc(n)
extern "C" void OSReport(const char*,...){}
extern "C" void re4dc_log(const char*,...){}

