using Outcome=re4dc::NativeDrawOutcome;
static re4dc::NativeDrawResult native_outcome{Outcome::UnsupportedBeforePublication};
static std::function<void(Cloth*)> native_callback;
static re4dc::NativeDrawResult re4dc_cloth_native(Cloth*c,cLight**,Vec*,float){
