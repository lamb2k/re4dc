    }
}
int main(){
    alpha12();material_headers12();classes12();boundaries12();callback12();
    std::printf("{\"alpha_cases\":%u,\"refusals_and_culls\":%u,\"assertions\":%u,\"sprite_bytes\":%zu,\"fast\":%u,\"setup\":%u,\"grid\":%u}\n",
        alpha_cases12,guard_cases12,gate::assertions,sizeof(Re4dcEffectSprite),RE4DC_ESP_SPRITE_FAST,RE4DC_ESP_SETUP_LEAN,RE4DC_ESP1B_GRID03);
