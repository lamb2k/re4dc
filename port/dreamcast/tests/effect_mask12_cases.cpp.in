        CHECK(lookups==1);
    }
    fresh12();auto e=effect12();cold12=true;
    CHECK(EspSpriteEmitResult03(&e).outcome==Outcome12::Queued && load_opens==1 && entries[0].frame==frame);
    for(unsigned action=1;action<=10;++action){
        fresh12();e=effect12();cold12=true;load_action12=action;phase12=action;
        no_publication12(EspSpriteEmitResult03(&e),action==5?Outcome12::PartialAbort:Outcome12::Refused);
        CHECK(load_opens==1);
    }
    fresh12();e=effect12();texture_missing=true;no_publication12(EspSpriteEmitResult03(&e),Outcome12::Refused);
    fresh12();e=effect12();stream_aborted=true;auto r=EspSpriteEmitResult03(&e);
    no_publication12(r,Outcome12::PartialAbort);CHECK(!r.fallback_allowed() && !lookups);
