    CHECK(r.outcome==Outcome12::PartialAbort && r.submitted==1 && !r.fallback_allowed());
    fresh12();e=effect12();fx_frame=frame;fx_count=RE4DC_EFFECT_SPRITE_MAX;no_publication12(EspSpriteEmitResult03(&e),Outcome12::Refused);
    fresh12();e=effect12();deferred_top=0;model_packets=nullptr;gate::allocation_ok=false;phase12=15;
    no_publication12(EspSpriteEmitResult03(&e),Outcome12::Refused);gate::allocation_ok=true;
    fresh12();auto sprite12=sprite();sprite12.color=0xc0804020;sprite12.pad=1;
    no_publication12(re4dc_effect_masked_sprite12_result(&sprite12,1),Outcome12::UnsupportedBeforePublication);
    sprite12.pad=0;sprite12.u[0]=NAN;
    no_publication12(re4dc_effect_masked_sprite12_result(&sprite12,1),Outcome12::UnsupportedBeforePublication);
    sprite12.u[0]=0;no_publication12(re4dc_effect_masked_sprite12_result(&sprite12,2),Outcome12::UnsupportedBeforePublication);
    const auto image12=sprite12.image;sprite12.image.pixels=nullptr;
    no_publication12(re4dc_effect_masked_sprite12_result(&sprite12,1),Outcome12::UnsupportedBeforePublication);
    sprite12.image=image12;sprite12.image.width=0;
    no_publication12(re4dc_effect_masked_sprite12_result(&sprite12,1),Outcome12::UnsupportedBeforePublication);
    sprite12.image=image12;
    rtt::capture_slot=0;no_publication12(re4dc_effect_masked_sprite12_result(&sprite12,1),Outcome12::UnsupportedBeforePublication);rtt::capture_slot=-1;
    fresh12();e=effect12();level_accept12=false;
    no_publication12(EspSpriteEmitResult03(&e),Outcome12::PolicySkip);CHECK(level_calls12==1 && !lookups);
    fresh12();e=effect12();level_accept12=false;s_effect_col.a=1;e.m_Tool_flg|=0x20000;
    no_publication12(EspSpriteEmitResult03(&e),Outcome12::PolicySkip);CHECK(level_calls12==1 && !lookups);
}
static void callback12(){
    for(unsigned scale:{0U,1U})for(unsigned alpha=0;alpha<256;++alpha){
        fresh12();auto e=effect12();e.m_Pos.z=-10;e.m_Col_a=alpha;if(scale)e.m_Tool_flg|=0x20000;
        EspCommonTrans(&e);const unsigned expected=scale?std::min(255U,alpha*4):alpha;
        CHECK(channel_calls03==1);
        if(expected<=1)CHECK(!deferred_count && !raw_sends);
