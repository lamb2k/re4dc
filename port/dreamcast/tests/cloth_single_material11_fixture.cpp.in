void identity11(Mtx m){PSMTXScale(m,1,1,1);}
void PSMTXIdentity(Mtx m){identity11(m);}
void RotMatrix(Mtx m,const Vec* v){assert(v->x==0&&v->y==0&&v->z==0);identity11(m);}
void low_RotMatrix(Mtx m,const Vec* v){RotMatrix(m,v);}
void TransMatrix(Mtx m,const Vec* v){m[0][3]=v->x;m[1][3]=v->y;m[2][3]=v->z;}
void Matrix2AxisAngle(const Mtx,Vec* v){*v={};}
void PSMTXInverse(const Mtx m,Mtx out){identity11(out);for(unsigned i=0;i<3;++i){assert(m[i][i]!=0);out[i][i]=1/m[i][i];out[i][3]=-m[i][3]/m[i][i];}}
void PSMTXTranspose(const Mtx m,Mtx out){Mtx t{};for(unsigned r=0;r<3;++r)for(unsigned c=0;c<3;++c)t[r][c]=m[c][r];std::memcpy(out,t,sizeof t);}
void PSVECScale(const Vec* a,Vec* b,float k){const Vec t={a->x*k,a->y*k,a->z*k};*b=t;}
void PSVECAdd(const Vec* a,const Vec* b,Vec* c){const Vec t={a->x+b->x,a->y+b->y,a->z+b->z};*c=t;}
void PSVECSubtract(const Vec* a,const Vec* b,Vec* c){const Vec t={a->x-b->x,a->y-b->y,a->z-b->z};*c=t;}
float PSVECMag(const Vec* v){return std::sqrt(v->x*v->x+v->y*v->y+v->z*v->z);}
void PSVECCrossProduct(const Vec* a,const Vec* b,Vec* c){*c={a->y*b->z-a->z*b->y,a->z*b->x-a->x*b->z,a->x*b->y-a->y*b->x};}
void VECNormalize(const Vec* a,Vec* b){float n=PSVECMag(a);if(n)PSVECScale(a,b,1/n);else *b={};}
