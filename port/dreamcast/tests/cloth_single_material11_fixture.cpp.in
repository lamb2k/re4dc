bool allocation_refused11=false;
void* mem_alloc(unsigned n,const char*,int,int,int){
 if(allocation_refused11)return nullptr;
 if(alloc_hook11){auto fn=alloc_hook11;alloc_hook11=nullptr;fn();}
 const unsigned bytes=(n+4095U)&~4095U;
 for(auto& a:heap11)if(!a.live&&a.capacity>=bytes){assert(!mprotect(a.pointer,a.capacity,PROT_READ|PROT_WRITE));a.live=true;return a.pointer;}
 void* p=mmap(nullptr,bytes,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS|MAP_32BIT,-1,0);assert(p!=MAP_FAILED);
 heap11.push_back({p,bytes,true});return p;
}
void Mem_free(void* p){if(!p)return;for(auto& a:heap11)if(a.pointer==p){assert(a.live);a.live=false;assert(!mprotect(p,a.capacity,PROT_NONE));
 if(free_hook11){auto fn=free_hook11;free_hook11=nullptr;fn();}return;}assert(false);}
