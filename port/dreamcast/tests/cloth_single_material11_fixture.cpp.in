cEsp4e* spawn11(unsigned cols=2,unsigned rows=3){
 cEsp* base=nullptr;assert(PullEsp(&base,0x4e));auto* e=static_cast<cEsp4e*>(base);
 e->m_Pos={0,0,-1000};e->m_Size_base_x=(float(cols)+.1f)*200/36;e->m_Size_base_y=(float(rows)+.1f)*200/24;
 e->parent=&world11;e->m_Col_r=64;e->m_Col_g=128;e->m_Col_b=192;e->m_Col_a=255;
 // Rebuild source offsets for each host invocation: the real relocator's
 // negative-address "already relocated" test belongs to the GC address map,
 // while ASan requires this synthetic archive in its low-memory region.
 source_tpl11->descriptorArray=reinterpret_cast<TEXDescriptor*>(64);
 reinterpret_cast<TEXDescriptor*>((unsigned char*)source_tpl11+64)->textureHeader=reinterpret_cast<TEXHeader*>(128);
 reinterpret_cast<TEXHeader*>((unsigned char*)source_tpl11+128)->data=reinterpret_cast<void*>(256);
 EspGenWork gen{};gen.Tool_flg=1;u32 seed=0;assert(e->SetFreeWork(&gen,&seed));
