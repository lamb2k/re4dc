+    }
+}
+int main(){
+    ClipEmitter sparse;stats={};sparse.setup(0);
+    assert(sparse.run()==1 && stats.strips_clipped==1 && sparse.portal_depth_safe_clip);
+    assert(sparse.input==63 && sparse.output==63 && sparse.sent.size()==189);
+    // Every emitted TA command comes from the production clipper. Sparse
+    // gather and the old full gather must send the same complete packet.
+    ClipEmitter full;stats={};full.setup(0);
+    for(unsigned i=0;i<65;++i)full.gathered[i]=full.package.pool[full.package.offsets[i]];
+    full.stream_l=nullptr;
+    assert(full.run(true)==1 && full.sent.size()==sparse.sent.size());
+    assert(std::memcmp(full.sent.data(),sparse.sent.data(),sparse.sent.size()*sizeof(pvr_vertex_t))==0);
+    assert(receipt(sparse).witnessed());
+    // Three wholly near-rejected corners followed by a near crossing can
+    // balance one lost and one split triangle: equal totals are insufficient.
+    ClipEmitter crossing;stats={};crossing.setup(3);
+    assert(crossing.run()==1 && !crossing.portal_depth_safe_clip);
+    assert(crossing.input==63 && crossing.output==63);
+    assert(!receipt(crossing).witnessed());
+    ClipEmitter culled;stats={};culled.setup(65);
+    assert(culled.run()==1 && !receipt(culled).witnessed());
+    ClipEmitter backface;stats={};backface.setup(0);backface.p.cull=3;
+    assert(backface.run()==1 && backface.portal_depth_safe_clip && backface.output==0);
+    assert(!receipt(backface).witnessed());
+#if RE4DC_WORLD_PAGES31
+    page_cases();
+#else
+    ClipEmitter direct;stats={};direct.setup(0);assert(direct.run()==1);
+    re4dc::page31::Part unused(0,1);
+    assert(flush_page(direct,unused,0,true,1)==1 && receipt_count==1);
+    ClipEmitter near_crossing;stats={};near_crossing.setup(3);assert(near_crossing.run()==1);
+    assert(flush_page(near_crossing,unused,0,true,1)==1 && receipt_count==1);
+#endif
