+@PAGE_INPUTS@
+int flush_page(ClipEmitter& e,re4dc::page31::Part& proof,unsigned first,bool last,int result){
+    struct Pick {unsigned let,nr;};Pick pick{first,0xff};
+    proof.selected(&pick,1);
+    proof.emitted(result,e.submitted,e.input,e.output);
+    auto& cpkg=e.package;const auto& wp29_source=cpkg.parts()[0];
+    struct X {unsigned index=0,count=1,key[6]{};
+              re4dc::portal29::Ticket wp29_ticket{1,0,7,0};} x;
+    struct {Batch batch;} submit_scope;
+    ChunkPageInputs inputs{};float affine[12]{};inputs.capture(ps2w.meta,affine);
+    auto* active_page=&proof;const auto* active_page_inputs=&inputs;
+    const float* active_page_affine=affine;
+    const unsigned active_page_index=0,active_page_plan=1;
+    const bool active_page_last=last;unsigned nctx=1,npk=1;
+#if RE4DC_WORLD_PAGES31
+    const bool wp29_whole=re4dc::portal29::whole_source(&pick,1,0,2);
+#else
+    const bool wp29_whole=re4dc::portal29::whole_source(&pick,1,0,1);
