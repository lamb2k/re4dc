+def extract_methods():
+    path = ROOT / "port/dreamcast/tools/d367/world_submit_spike/check_runtime.py"
+    spec = importlib.util.spec_from_file_location("world_clip_extract", path)
+    module = importlib.util.module_from_spec(spec)
