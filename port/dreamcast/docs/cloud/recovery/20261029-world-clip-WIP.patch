+    bash port/dreamcast/tools/d367/ch2/ch2-build.sh rP
+  test -s "$output/re4dc-game.elf"
+  test -f "$output/missing.txt"
+  test ! -s "$output/missing.txt"
+}
+clip_target_arm ctrl 'SCENERY_CLIP_GATHER=0 WORLD_PORTAL_CLIP_GATHER31=0'
+clip_target_arm on 'SCENERY_CLIP_GATHER=1 WORLD_PORTAL_CLIP_GATHER31=1'
