+    return re4dc::portal29::Completion::emitted(1,e.submitted,e.input,e.output,whole && e.portal_depth_safe_clip);
+}
+struct Ps2Part {std::uint32_t crc=1,fnv=2;std::uint16_t width=64,height=64;
