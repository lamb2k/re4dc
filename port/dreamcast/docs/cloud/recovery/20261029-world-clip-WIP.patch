+void page_cases(){
+    auto reset=[](){ps2w.meta={};ps2w.parts=&ps2w.meta;
+        std::fill(std::begin(ps2w.view),std::end(ps2w.view),0.f);
+        frame=1;plan_valid=true;mutate_on_close=0;
+        abort_count=receipt_count=finish_count=close_count=0;c={};};
+    reset();re4dc::page31::Part good(0,2);ClipEmitter a,b;
+    a.setup(0);b.setup(0);assert(a.run()==1 && b.run()==1);
+    assert(flush_page(a,good,0,false,1)==1 && receipt_count==0);
+    assert(flush_page(b,good,1,true,1)==1 && receipt_count==1 && close_count==2);
+    reset();re4dc::page31::Part crossing(0,2);ClipEmitter c0,c1;
+    c0.setup(3);c1.setup(0);assert(c0.run()==1 && c1.run()==1);
+    assert(flush_page(c0,crossing,0,false,1)==1);
+    assert(flush_page(c1,crossing,1,true,1)==1 && receipt_count==0);
+    reset();re4dc::page31::Part refused(0,2);ClipEmitter r0,r1;
+    r0.setup(0);r1.setup(0);assert(r0.run()==1 && r1.run()==1);
+    assert(flush_page(r0,refused,0,false,1)==1);
+    assert(flush_page(r1,refused,1,true,0)==-1 && receipt_count==0 && abort_count==1);
+    reset();re4dc::page31::Part first_refused(0,2);ClipEmitter rf;
+    rf.setup(0);assert(rf.run()==1);
+    assert(flush_page(rf,first_refused,0,false,0)==-1 && receipt_count==0 && abort_count==1);
+    for(unsigned mutation=1;mutation<=3;++mutation){
+        reset();re4dc::page31::Part mutated(0,2);ClipEmitter m0,m1;
+        m0.setup(0);m1.setup(0);assert(m0.run()==1 && m1.run()==1);
+        assert(flush_page(m0,mutated,0,false,1)==1);
+        mutate_on_close=mutation;
