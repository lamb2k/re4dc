+  test ! -e "$output"
+  ROUTE_OUT_ROOT="$RUN_ROOT/$arm" ROUTE_PROGRAMS_DIR="$RUN_ROOT/programs-$arm" \
+    ROUTE_PROGRAMS_JSON='' T="$PWD" K="$RUN_ROOT/$arm-logs" LP="$label" \
